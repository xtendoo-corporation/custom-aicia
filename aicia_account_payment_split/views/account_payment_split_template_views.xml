<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- PLANTILLA DE REPARTO - VISTAS                                -->
        <!-- ============================================================ -->

        <!-- TREE VIEW -->
        <record id="view_split_template_tree" model="ir.ui.view">
            <field name="name">account.payment.split.template.list</field>
            <field name="model">account.payment.split.template</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="journal_id" />
                    <field name="debit_account_id" />
                    <field name="split_base_mode" />
                    <field name="split_base_percentage" />
                    <field name="default_for_analytic_account_id" optional="show" />
                    <field name="priority" />
                    <field name="active" column_invisible="True" />
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_split_template_form" model="ir.ui.view">
            <field name="name">account.payment.split.template.form</field>
            <field name="model">account.payment.split.template</field>
            <field name="arch" type="xml">
                <form string="Plantilla de Reparto">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" placeholder="Nombre de la plantilla" />
                            </h1>
                        </div>

                        <group>
                            <group name="general" string="Configuración General">
                                <field name="active" widget="boolean_toggle" />
                                <field name="company_id" groups="base.group_multi_company" />
                                <field name="journal_id" />
                                <field name="debit_account_id" />
                            </group>
                            <group name="calculation" string="Cálculo del Reparto">
                                <field name="split_base_mode" widget="radio" />
                                <field name="split_base_percentage" />
                                <field name="default_for_analytic_account_id" />
                                <field name="priority" />
                            </group>
                        </group>

                        <notebook>
                            <page string="Líneas de Reparto" name="split_lines">
                                <field name="split_line_ids">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle" />
                                        <field name="name" />
                                        <field name="credit_account_id" />
                                        <field name="percentage" />
                                        <field name="analytic_account_id" optional="show" />
                                        <field name="analytic_distribution"
                                            optional="hide"
                                            groups="analytic.group_analytic_accounting" />
                                    </list>
                                </field>
                            </page>
                            <page string="Notas" name="notes">
                                <div class="alert alert-info" role="alert">
                                    <h5>Modos de Cálculo</h5>
                                    <p><strong>Líneas suman 100% (del % base):</strong> Los
                                        porcentajes de las líneas deben sumar 100%. El importe a
                                        repartir es <em>Porcentaje Base</em> del importe total del
                                        pago.<br /> Ejemplo: Base = 10%, Línea A = 40%, Línea B =
                                        60% → Si el pago es 1000€, se reparten 100€ (4% + 6%).</p>

                                    <p><strong>Líneas suman el % base directamente:</strong> Los
                                        porcentajes de las líneas deben sumar exactamente el <em>Porcentaje
                                        Base</em>.<br /> Ejemplo: Base = 10%, Línea A = 4%, Línea B
                                        = 3%, Línea C = 3% → Si el pago es 1000€, se reparten 100€
                                        (40€ + 30€ + 30€).</p>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_split_template_search" model="ir.ui.view">
            <field name="name">account.payment.split.template.search</field>
            <field name="model">account.payment.split.template</field>
            <field name="arch" type="xml">
                <search string="Plantillas de Reparto">
                    <field name="name" />
                    <field name="journal_id" />
                    <field name="debit_account_id" />
                    <field name="default_for_analytic_account_id" />
                    <separator />
                    <filter string="Archivados" name="inactive"
                        domain="[('active', '=', False)]" />
                    <separator />
                    <filter string="Compañía" name="group_company"
                        domain="[]"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company" />
                    <filter string="Diario" name="group_journal"
                        domain="[]"
                        context="{'group_by': 'journal_id'}" />
                    <filter string="Modo" name="group_mode"
                        domain="[]"
                        context="{'group_by': 'split_base_mode'}" />
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_split_template" model="ir.actions.act_window">
            <field name="name">Plantillas de Reparto de Cobros</field>
            <field name="res_model">account.payment.split.template</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una plantilla de reparto de cobros
                </p>
                <p>
                    Las plantillas definen cómo se distribuyen los importes cobrados
                    en asientos contables adicionales.
                </p>
            </field>
        </record>

    </data>
</odoo>
