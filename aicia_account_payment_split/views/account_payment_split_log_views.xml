<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- LOG DE REPARTO - VISTAS                                      -->
        <!-- ============================================================ -->

        <!-- TREE VIEW -->
        <record id="view_split_log_tree" model="ir.ui.view">
            <field name="name">account.payment.split.log.list</field>
            <field name="model">account.payment.split.log</field>
            <field name="arch" type="xml">
                <list create="false" edit="false"
                    decoration-muted="state == 'reversed'">
                    <field name="date" />
                    <field name="payment_id" />
                    <field name="template_id" />
                    <field name="split_move_id" />
                    <field name="amount_base_currency" />
                    <field name="currency_id" groups="base.group_multi_currency" />
                    <field name="amount_base_company" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="state" widget="badge"
                        decoration-success="state == 'posted'"
                        decoration-danger="state == 'reversed'" />
                </list>
            </field>
        </record>

        <!-- FORM VIEW -->
        <record id="view_split_log_form" model="ir.ui.view">
            <field name="name">account.payment.split.log.form</field>
            <field name="model">account.payment.split.log</field>
            <field name="arch" type="xml">
                <form string="Log de Reparto" create="false" edit="false">
                    <sheet>
                        <group>
                            <group string="Información del Reparto">
                                <field name="payment_id" />
                                <field name="template_id" />
                                <field name="split_move_id" />
                                <field name="date" />
                                <field name="state" widget="badge"
                                    decoration-success="state == 'posted'"
                                    decoration-danger="state == 'reversed'" />
                            </group>
                            <group string="Importes">
                                <field name="amount_base_currency" />
                                <field name="currency_id" />
                                <field name="amount_base_company" />
                                <field name="company_currency_id" invisible="1" />
                                <field name="company_id" groups="base.group_multi_company" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Facturas Relacionadas" name="invoices">
                                <field name="invoice_ids">
                                    <list create="false" edit="false">
                                        <field name="name" />
                                        <field name="partner_id" />
                                        <field name="amount_total" />
                                        <field name="payment_state" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record id="view_split_log_search" model="ir.ui.view">
            <field name="name">account.payment.split.log.search</field>
            <field name="model">account.payment.split.log</field>
            <field name="arch" type="xml">
                <search string="Logs de Reparto">
                    <field name="payment_id" />
                    <field name="template_id" />
                    <field name="split_move_id" />
                    <separator />
                    <filter string="Publicados" name="posted"
                        domain="[('state', '=', 'posted')]" />
                    <filter string="Revertidos" name="reversed"
                        domain="[('state', '=', 'reversed')]" />
                    <separator />
                    <filter string="Fecha" name="date" date="date" />
                    <separator />
                    <filter string="Plantilla" name="group_template"
                        domain="[]"
                        context="{'group_by': 'template_id'}" />
                    <filter string="Estado" name="group_state"
                        domain="[]"
                        context="{'group_by': 'state'}" />
                    <filter string="Fecha" name="group_date"
                        domain="[]"
                        context="{'group_by': 'date'}" />
                    <filter string="Compañía" name="group_company"
                        domain="[]"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company" />
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_split_log" model="ir.actions.act_window">
            <field name="name">Logs de Reparto de Cobros</field>
            <field name="res_model">account.payment.split.log</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_posted': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay logs de reparto
                </p>
                <p>
                    Los logs se generan automáticamente al postear pagos
                    que tengan una plantilla de reparto asignada.
                </p>
            </field>
        </record>

    </data>
</odoo>
