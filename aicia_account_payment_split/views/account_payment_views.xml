<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- ACCOUNT.PAYMENT - Extensión de vista formulario              -->
        <!-- ============================================================ -->

        <record id="view_account_payment_form_inherit_split" model="ir.ui.view">
            <field name="name">account.payment.form.inherit.split</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form" />
            <field name="arch" type="xml">

                <!-- Smart button: Asiento de Reparto + campos invisibles -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <field name="split_move_count" invisible="1" />
                    <field name="split_move_id" invisible="1" />
                    <button name="button_open_split_move"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="split_move_count == 0">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Asiento Reparto</span>
                        </div>
                    </button>
                </xpath>

                <!-- Campo split_template_id en el grupo 2 del formulario -->
                <xpath expr="//group[@name='group2']" position="inside">
                    <field name="split_template_id"
                        readonly="state != 'draft'"
                        options="{'no_create': True}" />
                </xpath>

            </field>
        </record>

        <!-- ============================================================ -->
        <!-- ACCOUNT.PAYMENT - Extensión de vista lista                   -->
        <!-- ============================================================ -->

        <record id="view_account_payment_tree_inherit_split" model="ir.ui.view">
            <field name="name">account.payment.list.inherit.split</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree" />
            <field name="arch" type="xml">
                <field name="state" position="before">
                    <field name="split_template_id" optional="hide" string="Plantilla Reparto" />
                </field>
            </field>
        </record>

    </data>
</odoo>
