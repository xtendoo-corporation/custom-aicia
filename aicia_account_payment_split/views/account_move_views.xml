<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ============================================================ -->
        <!-- ACCOUNT.MOVE (Facturas) - Smart button repartos              -->
        <!-- ============================================================ -->

        <record id="view_move_form_inherit_split" model="ir.ui.view">
            <field name="name">account.move.form.inherit.split</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="button_open_split_logs"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-exchange"
                        invisible="split_log_count == 0">
                        <div class="o_stat_info">
                            <field name="split_log_count" />
                            <span class="o_stat_text">Repartos</span>
                        </div>
                    </button>
                </xpath>

            </field>
        </record>

    </data>
</odoo>
