<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_form_inherit" model="ir.ui.view">
        <field name="name">account.analytic.account.form.inherit.payment.split</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']" position="inside">
                <group name="payment_split" string="Reparto de Pagos">
                    <field name="payment_split_template_id" options="{'no_create': True}" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
