
<odoo>
    <record id="aicia_nomina_import_wizard_view" model="ir.ui.view">
        <field name="name">aicia.nomina.import.wizard</field>
        <field name="model">aicia.nomina.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="pdf_file"/>
                <field name="filename"/>
                <field name="log_html" readonly="1"/>
                <footer>
                    <button name="action_import" type="object"
                            string="Importar" class="btn-primary"/>
                    <button special="cancel"
            string="Cerrar"
            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_aicia_nomina_import" model="ir.actions.act_window">
        <field name="name">Importar nóminas PDF</field>
        <field name="res_model">aicia.nomina.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="aicia_nomina_menu"
              name="Importar nóminas"
              parent="hr.menu_hr_root"
              action="action_aicia_nomina_import"/>
</odoo>
