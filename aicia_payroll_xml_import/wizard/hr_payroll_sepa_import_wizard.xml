<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payroll_sepa_import_wizard" model="ir.ui.view">
        <field name="name">hr.payroll.sepa.import.wizard.form</field>
        <field name="model">hr.payroll.sepa.import.wizard</field>
        <field name="arch" type="xml">

            <form string="Importar remesa SEPA">

                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>

                <group invisible="not log">
                    <separator string="Resultado"/>

                    <field name="log"
                           nolabel="1"
                           readonly="1"
                           widget="text"/>
                </group>

                <footer>

                    <button name="action_import"
                            type="object"
                            string="Importar"
                            class="btn btn-primary"
                            invisible="log"/>

                    <button string="Cerrar"
                            special="cancel"
                            class="btn-secondary"/>

                </footer>

            </form>

        </field>
    </record>

    <record id="action_hr_payroll_sepa_import" model="ir.actions.act_window">
        <field name="name">Importar Remesa SEPA</field>
        <field name="res_model">hr.payroll.sepa.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_hr_payroll_sepa"
              name="Remesas SEPA"
              parent="aicia_importer.aicia_menu_hr"
              action="action_hr_payroll_sepa_import"/>
</odoo>
