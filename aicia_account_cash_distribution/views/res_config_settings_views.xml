<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.aicia</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[.//field[@name='group_analytic_accounting']]" position="after">
                <block title="AICIA Cash Distribution" id="aicia_cash_distribution">
                    <setting string="Enable Cash Distribution" help="Enable automatic analytic distribution on reconciliation">
                        <field name="cash_distribution_active"/>
                        <div class="content-group" invisible="not cash_distribution_active">
                            <div class="row mt16">
                                <label for="cash_distribution_journal_id" class="col-lg-3 o_light_label"/>
                                <field name="cash_distribution_journal_id"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>

