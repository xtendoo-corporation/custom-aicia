<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aicia_distribution_move_tree" model="ir.ui.view">
        <field name="name">aicia.distribution.move.tree</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Asientos de Distribución" create="false" edit="false">
                <field name="date"/>
                <field name="name"/>
                <field name="ref" optional="show"/>
                <field name="distribution_payment_id" string="Pago" optional="hide"/>
                <field name="distribution_partial_reconcile_id" string="Conciliación" optional="hide"/>
                <field name="distribution_source_analytic_ids" widget="many2many_tags" optional="show"/>
                <field name="distribution_applied_plan_ids" widget="many2many_tags" optional="hide"/>
                <field name="amount_total"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'posted'"
                       decoration-warning="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_aicia_distribution_move" model="ir.actions.act_window">
        <field name="name">Asientos de Distribución</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("is_cash_distribution_move", "=", True)]</field>
        <field name="context">{"default_is_cash_distribution_move": True}</field>
        <field name="view_id" ref="view_aicia_distribution_move_tree"/>
    </record>
</odoo>

