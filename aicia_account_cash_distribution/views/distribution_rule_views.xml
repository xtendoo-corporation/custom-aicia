<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aicia_distribution_rule_tree" model="ir.ui.view">
        <field name="name">aicia.distribution.rule.tree</field>
        <field name="model">aicia.distribution.rule</field>
        <field name="arch" type="xml">
            <list string="Distribution Rules" editable="bottom">
                <field name="name"/>
                <field name="type"/>
                <field name="percentage"/>
                <field name="debit_account_id"/>
                <field name="credit_account_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_aicia_distribution_rule_form" model="ir.ui.view">
        <field name="name">aicia.distribution.rule.form</field>
        <field name="model">aicia.distribution.rule</field>
        <field name="arch" type="xml">
            <form string="Distribution Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="percentage"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="debit_account_id"/>
                            <field name="credit_account_id"/>
                        </group>
                    </group>
                    <group string="Analytic Configuration">
                        <field name="source_analytic_account_ids" widget="many2many_tags"
                               invisible="type == 'fixed'"/>
                        <field name="destination_analytic_account_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aicia_distribution_rule" model="ir.actions.act_window">
        <field name="name">Distribution Rules</field>
        <field name="res_model">aicia.distribution.rule</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>

