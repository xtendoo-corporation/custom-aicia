<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Añadir campo distribution_plan_id en el formulario de cuenta analítica -->
    <record id="view_account_analytic_account_form_inherit_aicia" model="ir.ui.view">
        <field name="name">account.analytic.account.form.inherit.aicia</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='plan_id']" position="after">
                <field name="distribution_plan_id"
                       options="{'no_create': True}"
                       placeholder="Sin plan asignado — no se distribuirán los cobros"
                       groups="account.group_account_user"/>
            </xpath>
        </field>
    </record>

    <!-- Smart button distribuciones en la cabecera -->
    <record id="view_account_analytic_account_form_button_inherit_aicia" model="ir.ui.view">
        <field name="name">account.analytic.account.form.button.inherit.aicia</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="action"
                        name="%(aicia_account_cash_distribution.action_aicia_distribution_move)d"
                        context="{'search_default_distribution_source_analytic_ids': [id], 'default_is_cash_distribution_move': True}"
                        domain="[('is_cash_distribution_move', '=', True), ('distribution_source_analytic_ids', 'in', [id])]"
                        icon="fa-list-alt"
                        groups="account.group_account_user">
                    <field name="distribution_move_count" widget="statinfo" string="Distribuciones"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

