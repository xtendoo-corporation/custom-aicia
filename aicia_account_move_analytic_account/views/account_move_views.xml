<odoo>
    <record id="view_move_form_analytic_account" model="ir.ui.view">
        <field name="name">account.move.form.analytic.account</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field string="Distribución Analítica" name="analytic_distribution" no-label="True" widget="analytic_distribution" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_analytic_account_tree" model="ir.ui.view">
        <field name="name">account.move.analytic.account.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <!-- Añade solo el grupo de trabajo después del proyecto existente -->
            <xpath expr="//field[@name='analytic_distribution']" position="after">
                <field name="work_group_id"/>
            </xpath>
        </field>
    </record>
</odoo>

