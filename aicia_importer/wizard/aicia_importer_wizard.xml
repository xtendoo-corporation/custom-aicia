        <field name="res_model">aicia.importer.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="aicia_importer_customers_view"/>
        <field name="target">new</field>
    </record>

    <!-- Acción para EMPLEADOS -->
    <record id="aicia_importer_employees_action" model="ir.actions.act_window">
        <field name="name">Importar Personal</field>
        <field name="res_model">aicia.importer.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="aicia_importer_employees_view"/>
