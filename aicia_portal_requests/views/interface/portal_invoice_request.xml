<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_portal_invoice_request_tree" model="ir.ui.view">
            <field name="name">portal.invoice.request.tree</field>
            <field name="model">portal.invoice.request</field>
            <field name="arch" type="xml">
                <list string="Portal Invoice Requests">
                    <field name="user_id"/>
                    <field name="analytic_id"/>
                    <field name="partner_id"/>
                    <field name="work_group_id" optional="hidden"/>
                    <field name="amount"/>
                    <field name="move_type"/>
                    <field name="date"/>
                    <field name="l10n_es_edi_facturae_reason_code"/>
                    <field name="approved"/>
                </list>
            </field>
        </record>

        <record id="view_portal_invoice_request_form" model="ir.ui.view">
            <field name="name">portal.invoice.request.form</field>
            <field name="model">portal.invoice.request</field>
            <field name="arch" type="xml">
                <form string="Portal Invoice Request">
                    <header>
                        <field name="status" widget="statusbar"/>
                        <field name="show_solicitar_revision" invisible="1"/>
                        <!-- Botonera jefe de equipo -->
                        <button name="action_approve"
                                string="Solicitar Revisión"
                                type="object"
                                class="btn-primary"
                                invisible="not show_solicitar_revision"
                                />
                        <!-- Fin botonera jefe de equipo -->
                        <!-- Botonera jefe de equipo -->
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                                groups="aicia_portal_requests.group_equip_boss"
                                invisible="status in ('approved_by_client_responsible','approve','to_revise','rejected')"
                                />

                        <button name="action_reject"
                                string="Reject"
                                type="object"
                                class="btn-secondary"
                                groups="aicia_portal_requests.group_equip_boss"
                                invisible="status in ('approved_by_client_responsible','approve','to_revise','rejected')"
                                />
                        <!-- Fin botonera jefe de equipo -->
                        <!-- Botonera Responsable clientes y becarios -->
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                                groups="aicia_portal_requests.group_intern_partner_responsible"
                                invisible="status in ('approved_by_boss_group','approve','to_revise','rejected')"
                                />
                        <button name="action_reject"
                                string="Reject"
                                type="object"
                                class="btn-secondary"
                                groups="aicia_portal_requests.group_intern_partner_responsible"
                                invisible="status in ('approved_by_boss_group','approve','to_revise','rejected')"
                                />
                        <!-- Fin botonera Responsable clientes y becarios -->

<!--                         <button name="action_approve"-->
<!--                                string="Approve"-->
<!--                                type="object"-->
<!--                                class="btn-primary"-->
<!--                                invisible="is_revised == True"/>-->
<!--                        <button name="action_reject"-->
<!--                                string="Reject"-->
<!--                                type="object"-->
<!--                                class="btn-secondary"-->
<!--                                invisible="is_revised == True"/>-->
<!--                        <button name="action_to_revise"-->
<!--                                string="Para Revisar"-->
<!--                                type="object"-->
<!--                                class="btn-secondary"-->
<!--                                invisible="not is_revised or approved"/>-->
                    </header>
                    <sheet>

                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_created">
                        <field name="invoice_count" widget="statinfo" string="Invoices"/>
                    </button>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="analytic_id"/>
                                <field name="partner_id"/>
                                <field name="send_draft"/>
                                <field name="invoice_created" invisible="1"/>
                                <field name="invoice_to_refund" invisible="move_type == 'out_invoice'" readonly="1"/>
                            </group>
                            <group>
                                <field name="amount"/>
                                <field name="move_type"/>
                                <field name="date"/>
                                <field name="approved" invisible="1"/>
                            </group>
                        </group>
                        <group>
                            <field name="notes" widget="textarea"/>
                        </group>
                        <group>
                            <field name="l10n_es_edi_facturae_reason_code" invisible="move_type == 'out_invoice'"/>
                        </group>
                    </sheet>
                     <chatter/>
                </form>
            </field>
        </record>
        <record id="action_portal_invoice_request_approved" model="ir.actions.act_window">
            <field name="name">Approved</field>
            <field name="res_model">portal.invoice.request</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('approved', '=', True)]</field>
            <field name="context">{'group_by': 'analytic_id'}</field>
        </record>

        <record id="action_portal_invoice_request_notapproved" model="ir.actions.act_window">
            <field name="name">Not approved</field>
            <field name="res_model">portal.invoice.request</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_revised', '=', True), ('approved', '=', False), ('move_type', '=', 'out_invoice')]</field>
            <field name="context">{'group_by': 'analytic_id'}</field>
        </record>

        <record id="action_portal_refund_request_notapproved" model="ir.actions.act_window">
            <field name="name">Not approved</field>
            <field name="res_model">portal.invoice.request</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('is_revised', '=', True), ('approved', '=', False), ('move_type', '=', 'out_invoice')]</field>
            <field name="context">{'group_by': 'analytic_id'}</field>
        </record>

        <record id="view_portal_invoice_request_search" model="ir.ui.view">
            <field name="name">portal.invoice.request.search</field>
            <field name="model">portal.invoice.request</field>
            <field name="arch" type="xml">
                <search string="Facturas">
                    <field name="is_revised"/>
                    <filter string="Para revisar" name="approved_filter" domain="[('is_revised', '=', False)]"/>
                    <field name="approved"/>
                    <filter string="Aprobadas" name="approved_filter" domain="[('approved', '=', True)]"/>
                    <field name="approved"/>
                    <filter string="Rechazadas" name="rejected_filter" domain="[('approved', '=', False), ('is_revised', '=', True)]"/>
                </search>
            </field>
        </record>


         <record id="action_portal_invoice_request_all_invoice" model="ir.actions.act_window">
            <field name="name">Facturas</field>
            <field name="res_model">portal.invoice.request</field>
            <field name="view_mode">list,form</field>
             <field name="domain">[('move_type', '=', 'out_invoice')]</field>
            <field name="context">{'group_by': 'analytic_id'}</field>
        </record>

        <record id="action_portal_invoice_request_all_refund" model="ir.actions.act_window">
            <field name="name">Facturas rectificativas</field>
            <field name="res_model">portal.invoice.request</field>
            <field name="view_mode">list,form</field>
             <field name="domain">[('move_type', '=', 'out_refund')]</field>
            <field name="context">{'group_by': 'analytic_id'}</field>
        </record>

        <menuitem id="menu_portal_invoice_request_all_invoice"
                  name="Facturas"
                  parent="aicia_portal_requests.portal_requests_menu"
                  action="action_portal_invoice_request_all_invoice"
                  groups="aicia_portal_requests.group_intern_partner_responsible"
                  sequence="30"/>
        <menuitem id="menu_portal_invoice_request_all_refundd"
                  name="Facturas rectificativas"
                  parent="aicia_portal_requests.portal_requests_menu"
                  action="action_portal_invoice_request_all_refund"
                  groups="aicia_portal_requests.group_intern_partner_responsible"
                  sequence="40"/>

