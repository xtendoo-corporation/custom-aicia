<!--                  name="Not approved"-->
<!--                  parent="aicia_portal_requests.menu_portal_invoice_request"-->
<!--                  action="action_portal_invoice_request_notapproved"-->
<!--                  sequence="40"/>-->
    </data>
</odoo>
