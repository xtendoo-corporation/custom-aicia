<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_portal_request_etiqueta_tree" model="ir.ui.view">
        <field name="name">portal.request.etiqueta.tree</field>
        <field name="model">portal.request.etiqueta</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="view_portal_request_etiqueta_form" model="ir.ui.view">
        <field name="name">portal.request.etiqueta.form</field>
        <field name="model">portal.request.etiqueta</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_portal_request_categoria_tree" model="ir.ui.view">
        <field name="name">portal.request.categoria.tree</field>
        <field name="model">portal.request.categoria</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="view_portal_request_categoria_form" model="ir.ui.view">
        <field name="name">portal.request.categoria.form</field>
        <field name="model">portal.request.categoria</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_etiqueta" model="ir.actions.act_window">
            <field name="name">Etiquetas</field>
            <field name="res_model">portal.request.etiqueta</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="action_portal_request_etiqueta"
                  name="Etiquetas"
                  parent="aicia_portal_requests.portal_requests_menu"
                  action="action_etiqueta"
                  sequence="60"/>

    <record id="action_categoria" model="ir.actions.act_window">
            <field name="name">Categorias</field>
            <field name="res_model">portal.request.categoria</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="action_portal_request_categoria"
                  name="Categorias"
                  parent="aicia_portal_requests.portal_requests_menu"
                  action="action_categoria"
                  sequence="60"/>

</odoo>
