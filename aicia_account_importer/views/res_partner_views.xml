<odoo>
    <record id="view_partner_form_aicia_code" model="ir.ui.view">
        <field name="name">res.partner.form.aicia.code</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Códigos AICIA" name="aicia_codes">
                    <field name="aicia_code_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="partner_type"/>
                            <field name="code"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
