<odoo>
    <record id="view_aicia_no_partner_account_list" model="ir.ui.view">
        <field name="name">aicia.account.importer.no.partner.account.list</field>
        <field name="model">aicia.account.importer.no.partner.account</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="source_code" placeholder="Ej: 430000000"/>
                <field name="name"/>
                <field name="use_full_code"/>
                <field name="account_name" optional="show"/>
                <field name="note"/>
            </list>
        </field>
    </record>
    <record id="view_aicia_no_partner_account_search" model="ir.ui.view">
        <field name="name">aicia.account.importer.no.partner.account.search</field>
        <field name="model">aicia.account.importer.no.partner.account</field>
        <field name="arch" type="xml">
            <search string="Buscar cuentas sin socio">
                <field name="source_code"/>
                <field name="name"/>
            </search>
        </field>
    </record>
    <record id="action_aicia_no_partner_account" model="ir.actions.act_window">
        <field name="name">Cuentas sin socio</field>
        <field name="res_model">aicia.account.importer.no.partner.account</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_aicia_no_partner_account_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Añade una cuenta legada que no lleve socio.
            </p>
            <p>
                Las líneas de estas cuentas se importan sin contacto y sin aviso, aunque su
                grupo sea de cliente, proveedor o personal. Puede ser la cuenta completa
                (9 dígitos) o un prefijo. Con "Importar con los 9 dígitos" (solo cuentas de
                9 dígitos) la cuenta de Odoo es el código legado completo.
            </p>
        </field>
    </record>
</odoo>
