<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aicia_payroll_config_list" model="ir.ui.view">
        <field name="name">aicia.payroll.config.list</field>
        <field name="model">aicia.payroll.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="journal_id"/>
                <field name="include_management_costs"/>
                <field name="include_ct_costs"/>
                <field name="include_travel_costs"/>
                <field name="group_by_employee"/>
            </list>
        </field>
    </record>

    <record id="view_aicia_payroll_config_form" model="ir.ui.view">
        <field name="name">aicia.payroll.config.form</field>
        <field name="model">aicia.payroll.config</field>
        <field name="arch" type="xml">
            <form string="Configuración nóminas AICIA">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="journal_id"/>
                        </group>
                    </group>
                    <group string="Cuentas principales de nómina">
                        <group>
                            <field name="salary_expense_account_id"/>
                            <field name="company_social_security_expense_account_id"/>
                            <field name="employee_payable_account_id"/>
                        </group>
                        <group>
                            <field name="irpf_payable_account_id"/>
                            <field name="social_security_payable_account_id"/>
                            <field name="bonus_expense_account_id"/>
                        </group>
                    </group>
                    <group string="Cuentas de deducciones y anticipos">
                        <group>
                            <field name="advance_account_id"/>
                            <field name="deduction_payable_account_id"/>
                        </group>
                        <group>
                            <field name="diet_expense_account_id"/>
                            <field name="km_expense_account_id"/>
                        </group>
                    </group>
                    <group string="Costes auxiliares">
                        <group>
                            <field name="management_cost_expense_account_id"/>
                            <field name="management_cost_payable_account_id"/>
                            <field name="ct_cost_expense_account_id"/>
                            <field name="ct_cost_payable_account_id"/>
                        </group>
                        <group>
                            <field name="travel_cost_expense_account_id"/>
                            <field name="travel_cost_payable_account_id"/>
                        </group>
                    </group>
                    <group string="Opciones">
                        <group>
                            <field name="include_management_costs"/>
                            <field name="include_ct_costs"/>
                            <field name="include_travel_costs"/>
                            <field name="group_by_employee"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aicia_payroll_config" model="ir.actions.act_window">
        <field name="name">Configuración nóminas</field>
        <field name="res_model">aicia.payroll.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
