<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">
        <!-- Nueva categoría para Aicia -->
        <record id="module_category_aicia" model="ir.module.category">
            <field name="name">Aicia</field>
            <field name="sequence">10</field>
        </record>

        <!-- Grupos de usuarios para Aicia -->
        <record id="group_director_investigation_and_development" model="res.groups">
            <field name="name">Director I+D</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>
        <record id="group_director_manager" model="res.groups">
            <field name="name">Director Gerente</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>
        <record id="group_personnel_responsible" model="res.groups">
            <field name="name">Responsable de Personal</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>

         <record id="group_partner_responsible" model="res.groups">
            <field name="name">Responsable de Clientes</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>

         <record id="group_intern_responsible" model="res.groups">
            <field name="name">Responsable de Becarios</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>

         <record id="group_purchase_responsible" model="res.groups">
            <field name="name">Responsable de Compras</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>

        <record id="group_project_boss" model="res.groups">
            <field name="name">Jefe de Proyecto</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>
         <record id="group_equip_boss" model="res.groups">
            <field name="name">Jefe de Equipo</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>

        <record id="rule_project_boss_company" model="ir.rule">
            <field name="name">Project Boss: Only Own Company</field>
            <field name="model_id" ref="portal_requests.model_document_approval"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_project_boss'))]"/>
        </record>

          <record id="rule_equip_boss_company" model="ir.rule">
            <field name="name">Equip Boss: Only Own Company</field>
            <field name="model_id" ref="portal_requests.model_document_approval"/>
            <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
            <field name="groups" eval="[(4, ref('group_equip_boss'))]"/>
        </record>

         <record id="group_financial_director" model="res.groups">
            <field name="name">Director Financiero</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>

        <!-- Record Rule: Cuentas Analíticas del mismo grupo de trabajo (Solo Lectura para usuarios base) -->
