        <!-- Record Rule: Cuentas Analíticas del responsable (Solo Lectura para usuarios base) -->
        <record id="rule_analytic_account_responsible" model="ir.rule">
            <field name="name">Analytic Account: Responsable (Read Only)</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[('responsible_id.id', '=', user.id)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

         <!-- Record Rule: Cuentas Analíticas del Jefe del grupo (Solo Lectura para usuarios base) -->
        <record id="rule_analytic_account_work_group_boss" model="ir.rule">
            <field name="name">Analytic Account: Boss Work Group (Read Only)</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[('work_group_boss_id.id', '=', user.id)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_equip_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: Director Gerente puede ver/editar TODAS las cuentas analíticas -->
        <record id="rule_analytic_account_work_group_all" model="ir.rule">
            <field name="name">Analytic Account: Director Manager - Full Access</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_director_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

          <!-- Record Rule: Director i+d puede ver/editar TODAS las cuentas analíticas -->
        <record id="rule_analytic_account_work_group_all_i_d" model="ir.rule">
            <field name="name">Analytic Account: Director I+D - Full Access</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_director_investigation_and_development'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


