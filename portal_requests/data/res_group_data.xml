<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data noupdate="0">

        <!-- Nueva categoría para Aicia -->
        <record id="module_category_aicia" model="ir.module.category">
            <field name="name">Solicitudes del Portal</field>
            <field name="sequence">10</field>
        </record>

        <!-- Privilegio Aicia - Odoo 19 usa privilegios en lugar de category_id directamente en grupos -->
        <record id="privilege_aicia" model="res.groups.privilege">
            <field name="name">Tipo de usuario</field>
            <field name="category_id" ref="module_category_aicia"/>
        </record>


        <!-- Grupos de usuarios para Aicia -->
        <record id="group_director_investigation_and_development" model="res.groups">
            <field name="name">Director I+D</field>
            <field name="privilege_id" ref="privilege_aicia"/>
        </record>

           <record id="group_assistant_direction" model="res.groups">
            <field name="name">Secretaria de dirección</field>
            <field name="privilege_id" ref="privilege_aicia"/>
        </record>

        <record id="group_director_manager" model="res.groups">
            <field name="name">Director Gerente</field>
            <field name="privilege_id" ref="privilege_aicia"/>
        </record>
        <record id="group_personnel_purchase_responsible" model="res.groups">
            <field name="name">Responsable de Personal y compras</field>
            <field name="privilege_id" ref="privilege_aicia"/>
        </record>

         <record id="group_intern_partner_responsible" model="res.groups">
            <field name="name">Responsable de Clientes y Becarios</field>
            <field name="privilege_id" ref="privilege_aicia"/>
        </record>

<!--         <record id="group_intern_responsible" model="res.groups">-->
<!--            <field name="name">Responsable de Becarios</field>-->
<!--            <field name="privilege_id" ref="privilege_aicia"/>-->
<!--        </record>-->

<!--         <record id="group_purchase_responsible" model="res.groups">-->
<!--            <field name="name">Responsable de Compras</field>-->
<!--            <field name="privilege_id" ref="privilege_aicia"/>-->
<!--        </record>-->

        <record id="group_project_boss" model="res.groups">
            <field name="name">Jefe de Proyecto</field>
            <field name="privilege_id" ref="privilege_aicia"/>
        </record>

        <record id="rule_project_boss_company" model="ir.rule">
            <field name="name">Project Boss: Only Own Company</field>
            <field name="model_id" ref="portal_requests.model_document_approval"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_project_boss'))]"/>
        </record>

        <!-- Regla para usuarios portal: pueden ver y crear sus propios documentos -->
        <record id="rule_document_approval_portal" model="ir.rule">
            <field name="name">Portal Users: Own Documents Only</field>
            <field name="model_id" ref="portal_requests.model_document_approval"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <record id="rule_project_boss_invoice" model="ir.rule">
            <field name="name">Project Boss invoice request</field>
            <field name="model_id" ref="portal_requests.model_portal_invoice_request"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_project_boss'))]"/>
        </record>

         <record id="group_equip_boss" model="res.groups">
            <field name="name">Jefe de Equipo</field>
            <field name="privilege_id" ref="privilege_aicia"/>
        </record>

          <record id="rule_equip_boss_company" model="ir.rule">
            <field name="name">Equip Boss: Only Own Company</field>
            <field name="model_id" ref="portal_requests.model_document_approval"/>
            <field name="domain_force">[('work_group_id', 'in', user.work_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_equip_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>

        </record>

        <record id="rule_equip_boss_invoice" model="ir.rule">
            <field name="name">Equip Boss invoice request</field>
            <field name="model_id" ref="portal_requests.model_portal_invoice_request"/>
            <field name="domain_force">[('work_group_id', 'in', user.work_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_equip_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Perfil "Administrativo": mismo rol/funciones que
             Jefe de Equipo (aprobar/rechazar solicitudes de su equipo, dashboards,
             ver los mismos proyectos en "Mis Proyectos", etc, vía implied_ids),
             pero SIN acceso a la información económica de proyectos (saldos,
             presupuestos). El administrativo SÍ puede leer las cuentas
             analíticas de su equipo (para verlas en el listado), pero esos
             campos económicos se ocultan en la plantilla del portal. Esto se
             aplica explícitamente en:
             - controllers/portal_main.py: _hide_project_financials() (sección
               /my/analytic_projects: listado, detalle y exportación CSV)
             - controllers/portal_payment_requests_controller.py: _get_accessible_project_ids()
               (histórico de pagos, sección /my/payments, sigue excluido). -->
        <record id="group_administrative" model="res.groups">
            <field name="name">Administrativo</field>
            <field name="privilege_id" ref="privilege_aicia"/>
            <field name="implied_ids" eval="[(4, ref('group_equip_boss')), (4, ref('base.group_portal'))]"/>
        </record>

         <record id="group_financial_director" model="res.groups">
            <field name="name">Director Financiero</field>
            <field name="privilege_id" ref="privilege_aicia"/>
        </record>

        <!-- Record Rule: Cuentas Analíticas del responsable (Solo Lectura para usuarios base) -->
        <record id="rule_analytic_account_responsible" model="ir.rule">
            <field name="name">Analytic Account: Responsable (Read Only)</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[('responsible_id.id', '=', user.id)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: Cuentas Analíticas del responsable para usuarios PORTAL (Solo Lectura) -->
        <record id="rule_analytic_account_responsible_portal" model="ir.rule">
            <field name="name">Analytic Account: Responsable Portal (Read Only)</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[('responsible_id.id', '=', user.id)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

         <!-- Record Rule: Cuentas Analíticas del Jefe del grupo (Solo Lectura para usuarios base) -->
        <record id="rule_analytic_account_work_group_boss" model="ir.rule">
            <field name="name">Analytic Account: Boss Work Group (Read Only)</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <!-- group_administrative implica group_equip_boss: hereda el mismo acceso de
                 lectura a las cuentas analíticas de su equipo, tanto si es Jefe de Equipo
                 (work_group_boss_id) como si es el Administrativo asignado al grupo
                 (work_group_administrative_id) -para verlas en "Mis Proyectos". Los campos
                 económicos (saldo/presupuesto) se ocultan a nivel de plantilla del portal,
                 no a nivel de acceso al registro. -->
            <field name="domain_force">['|', ('work_group_boss_id.id', '=', user.id), ('work_group_administrative_id.id', '=', user.id)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_equip_boss'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Record Rule: Director Gerente puede ver/editar TODAS las cuentas analíticas -->
        <record id="rule_analytic_account_work_group_all" model="ir.rule">
            <field name="name">Analytic Account: Director Manager - Full Access</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_director_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

          <!-- Record Rule: Director i+d puede ver/editar TODAS las cuentas analíticas -->
        <record id="rule_analytic_account_work_group_all_i_d" model="ir.rule">
            <field name="name">Analytic Account: Director I+D - Full Access</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_director_investigation_and_development'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

           <!-- Record Rule: Responsable de Clientes y Becarios puede ver/editar TODAS las cuentas analíticas -->
        <record id="rule_analytic_account_work_group_client_responsible" model="ir.rule">
            <field name="name">Analytic Account: Responsable Clientes y Becarios - Full Access</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_intern_partner_responsible'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
            <!-- Record Rule: Responsable de Personal y Compras puede ver/editar TODAS las cuentas analíticas -->
        <record id="rule_analytic_account_work_group_purchase_responsible" model="ir.rule">
            <field name="name">Analytic Account: Responsable Personal y Compras - Full Access</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_personnel_purchase_responsible'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>


        <!--DUDA
        jefe de equipo -> habra que saignarle un ¿equipo? a que se refiere? equipo de ventas¿
        responsable proyecto -> habra que asociarle un proyecto -->

        <!-- Rol "Gestor": usuario de portal que puede ENVIAR y hacer seguimiento de
             las solicitudes de su equipo de trabajo, SIN acceso a informacion
             economica (saldos, presupuestos, historicos) ni a aprobar/rechazar. -->
        <record id="group_manager" model="res.groups">
            <field name="name">Gestor</field>
            <field name="privilege_id" ref="privilege_aicia"/>
            <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
        </record>

        <!-- Solicitudes del equipo: documentos -->
        <record id="rule_manager_document" model="ir.rule">
            <field name="name">Gestor: documentos de su equipo</field>
            <field name="model_id" ref="portal_requests.model_document_approval"/>
            <field name="domain_force">[('work_group_id', 'in', user.work_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Solicitudes del equipo: facturas -->
        <record id="rule_manager_invoice" model="ir.rule">
            <field name="name">Gestor: facturas de su equipo</field>
            <field name="model_id" ref="portal_requests.model_portal_invoice_request"/>
            <field name="domain_force">[('work_group_id', 'in', user.work_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Solicitudes del equipo: gastos -->
        <record id="rule_manager_expensive" model="ir.rule">
            <field name="name">Gestor: gastos de su equipo</field>
            <field name="model_id" ref="portal_requests.model_portal_hr_expensive_request"/>
            <field name="domain_force">[('work_group_id', 'in', user.work_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Solicitudes del equipo: proyectos -->
        <record id="rule_manager_project_request" model="ir.rule">
            <field name="name">Gestor: solicitudes de proyecto de su equipo</field>
            <field name="model_id" ref="portal_requests.model_portal_project_request"/>
            <field name="domain_force">[('work_group_id', 'in', user.work_group_ids.ids)]</field>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Lectura de cuentas analiticas de su equipo SOLO para poder
             seleccionarlas al crear solicitudes. No se le concede acceso a las
             vistas economicas (saldos/presupuestos/historicos), que siguen
             restringidas por responsable/jefe de equipo en los controladores. -->
        <record id="rule_manager_analytic_read" model="ir.rule">
            <field name="name">Gestor: cuentas analiticas de su equipo (solo lectura)</field>
            <field name="model_id" ref="analytic.model_account_analytic_account"/>
            <field name="domain_force">[('work_group_id', 'in', user.work_group_ids.ids)]</field>
            <field name="global" eval="False"/>
            <field name="groups" eval="[(4, ref('group_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
