<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Añadir tarjetas de Solicitudes al portal -->
        <template id="portal_my_home_requests" name="Portal My Home: Solicitudes"
                  customize_show="True" inherit_id="portal_requests.portal_my_home_inherit" priority="45">

            <!-- Crear una nueva categoría para solicitudes antes de portal_common_category -->
            <xpath expr="//div[@id='portal_common_category']" position="before">
                <div class="o_portal_category row g-2 mt-3" id="portal_requests_category">
                          <!-- Tarjeta de Solicitudes de Proyectos: solo visible para Jefes de Equipo -->
                    <t t-if="is_equip_boss">
                        <t t-call="portal.portal_docs_entry">
                            <t t-set="icon" t-value="'/portal_requests/static/src/img/request_project.svg'"/>
                            <t t-set="title">Solicitudes de Proyectos</t>
                            <t t-set="text">Consulta tus solicitudes de proyectos</t>
                            <t t-set="url" t-value="'/my/project_requests'"/>
                            <t t-set="config_card" t-value="True"/>
                        </t>
                    </t>
                     <t t-call="portal.portal_docs_entry">
                            <t t-set="icon" t-value="'/portal_requests/static/src/img/request_document.svg'"/>
                            <t t-set="title">Solicitudes de Documentos</t>
                            <t t-set="text">Consulta tus solicitudes de aprobación de documentos</t>
                            <t t-set="url" t-value="'/my/documents'"/>
                            <t t-set="config_card" t-value="True"/>
                        </t>
                     <t t-call="portal.portal_docs_entry">
                            <t t-set="icon" t-value="'/portal_requests/static/src/img/request_invoice.svg'"/>
                            <t t-set="title">Solicitudes de Facturas</t>
                            <t t-set="text">Consulta tus solicitudes de facturas</t>
                            <t t-set="url" t-value="'/my/invoices'"/>
                            <t t-set="config_card" t-value="True"/>
                        </t>
                    <t t-call="portal.portal_docs_entry">
                            <t t-set="icon" t-value="'/portal_requests/static/src/img/request_expense.svg'"/>
                            <t t-set="title">Solicitudes de Gastos</t>
                            <t t-set="text">Consulta tus solicitudes de gastos</t>
                            <t t-set="url" t-value="'/my/expenses'"/>
                            <t t-set="config_card" t-value="True"/>
                        </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/portal_requests/static/src/img/my_projects.svg'"/>
                        <t t-set="title">Mis Proyectos</t>
                        <t t-set="text">Consulta los proyectos de los que eres responsable</t>
                        <t t-set="url" t-value="'/my/analytic_projects'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/portal_requests/static/src/img/payments.svg'"/>
                        <t t-set="title">Pagos</t>
                        <t t-set="text">Consulta tus pagos realizados</t>
                        <t t-set="url" t-value="'/my/payments'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                    <t t-call="portal.portal_docs_entry">
                        <t t-set="icon" t-value="'/portal_requests/static/src/img/my_payroll.svg'"/>
                        <t t-set="title">Mis Nóminas</t>
                        <t t-set="text">Consulta y descargar tus Nóminas</t>
                        <t t-set="url" t-value="'/my/nomina'"/>
                        <t t-set="config_card" t-value="True"/>
                    </t>
                </div>
            </xpath>

        </template>
    </data>
</odoo>
