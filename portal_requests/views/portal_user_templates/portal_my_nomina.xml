<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_nomina_template" name="Mis Nóminas">

        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="True"/>

            <div class="portal-project-list-container">

                <!-- BREADCRUMB -->
                <div class="portal-project-breadcrumbs mb-3">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/my"><i class="fa fa-home"/></a></li>
                        <li class="breadcrumb-item active">Mis Nóminas</li>
                    </ol>
                </div>

                <!-- SEARCHBAR -->
                <div class="portal-project-searchbar-wrapper mb-4">

                    <div class="portal-project-searchbar d-flex flex-column flex-lg-row gap-2">

                        <!-- GROUP BY -->
                        <div class="btn-group">
                            <button class="btn btn-light dropdown-toggle" data-bs-toggle="dropdown">
                                Agrupar por:
                                <t t-esc="searchbar_groupby.get(groupby or 'none').get('label')"/>
                            </button>

                            <div class="dropdown-menu">
                                <t t-foreach="searchbar_groupby" t-as="g">
                                    <a class="dropdown-item"
                                       t-att-href="default_url + '?groupby=' + g">
                                        <t t-esc="searchbar_groupby[g]['label']"/>
                                    </a>
                                </t>
                            </div>
                        </div>

                        <!-- SEARCH -->
                        <form class="d-flex w-100">
                            <input type="text" name="search"
                                   class="form-control"
                                   t-att-value="search or ''"/>
                            <button class="btn btn-light">
                                <i class="fa fa-search"/>
                            </button>
                        </form>

                    </div>
                </div>

                <!-- LIST -->
                <div class="card">
                    <div class="card-body">

                        <t t-if="not attachments">
                            <div class="alert alert-info">No hay nóminas disponibles</div>
                        </t>

                        <!-- SIN AGRUPAR -->
                        <t t-if="groupby == 'none'">

                            <ul class="list-group">
                                <t t-foreach="attachments" t-as="att">

                                    <li class="list-group-item d-flex justify-content-between">

                                        <span t-esc="att.name"/>

                                        <a class="btn btn-sm btn-primary"
                                           t-att-href="'/my/nomina/download/%s' % att.id">
                                            Descargar
                                        </a>

                                    </li>

                                </t>
                            </ul>

                        </t>

                        <!-- AGRUPADO -->
                        <t t-if="groupby == 'year'">

                            <t t-foreach="payment_groups" t-as="group">

                                <h5 class="mt-3">
                                    <t t-esc="group['label']"/>
                                </h5>

                                <ul class="list-group mb-3">

                                    <t t-foreach="group['entries']" t-as="att">

                                        <li class="list-group-item d-flex justify-content-between">

                                            <span t-esc="att.name"/>

                                            <a class="btn btn-sm btn-primary"
                                               t-att-href="'/my/nomina/download/%s' % att.id">
                                                Descargar
                                            </a>

                                        </li>

                                    </t>

                                </ul>

                            </t>

                        </t>

                    </div>
                </div>

            </div>

        </t>

    </template>

</odoo>
