<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Breadcrumb para el detalle de solicitud -->
        <template id="portal_my_document_detail_breadcrumb" name="Portal: Detalle Solicitud de Documento"
                  inherit_id="portal.portal_breadcrumbs" priority="49">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'document_approval' and document" class="breadcrumb-item">
                    <a t-attf-href="/my/documents">Solicitudes de Documentos</a>
                </li>
                <li t-if="page_name == 'document_approval' and document" class="breadcrumb-item active">
                    Solicitud #<span t-esc="document.id"/>
                </li>
            </xpath>
        </template>

        <!-- Vista de detalle de la solicitud de documento -->
        <template id="portal_my_document_detail" name="Detalle de Solicitud de Documento">
            <t t-call="portal.portal_layout">
                <div id="wrap" class="o_portal_wrap">
                    <div class="container mt-3">
                        <!-- Mensajes de éxito -->
                        <div t-if="success_message == 'revision_requested'" class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>¡Solicitud enviada!</strong> Su solicitud de revisión final ha sido registrada correctamente.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                        <div t-if="success_message == 'message_posted'" class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>¡Mensaje enviado!</strong> Tu comentario ha sido publicado correctamente.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h3>Solicitud de Documento #<span t-esc="document.id"/></h3>
                                    <div>
                                        <!-- Botón Solicitar Revisión Final (solo jefe de equipo cuando está en sign_company) -->
                                        <form t-if="document.status == 'sign_company' and is_equip_boss"
                                              method="POST"
                                              t-attf-action="/my/documents/#{document.id}/request_revision"
                                              class="d-inline-block me-2">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-warning">
                                                <i class="fa fa-refresh me-1"/> Solicitar Revisión Final
                                            </button>
                                        </form>
                                        <!-- Botón Volver -->
                                        <a href="/my/documents" class="btn btn-secondary">
                                            <i class="fa fa-arrow-left"/> Volver al Listado
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-8">
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <h5 class="mb-0">Información General</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Tipo:</strong>
                                                <p><span t-field="document.type_id"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Grupo de Trabajo:</strong>
                                                <p><span t-field="document.work_group_id"/></p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-12">
                                                <strong>Descripción:</strong>
                                                <p><span t-field="document.description"/></p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Solicitante:</strong>
                                                <p><span t-field="document.user_id"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Fecha de Creación:</strong>
                                                <p><span t-field="document.create_date" t-options='{"widget": "datetime"}'/></p>
                                            </div>
                                        </div>
                                        <div class="row mb-3" t-if="document.is_company_signed">
                                            <div class="col-md-6">
                                                <strong>Firmado por la empresa:</strong>
                                                <p><span class="badge bg-success">Sí</span></p>
                                            </div>
                                        </div>
                                        <div class="row mb-3" t-if="document.sign_request_id">
                                            <div class="col-md-6">
                                                <strong>Firma digital:</strong>
                                                <p>
                                                    <span t-if="document.sign_request_state == 'signed'" class="badge bg-success">Firmado</span>
                                                    <span t-elif="document.sign_request_state == 'sent'" class="badge bg-warning">Pendiente de firma</span>
                                                    <span t-elif="document.sign_request_state == 'canceled'" class="badge bg-danger">Cancelado</span>
                                                    <span t-else="" class="badge bg-secondary">En proceso</span>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sección de adjuntos -->
                                <div class="card mb-3" t-if="attachments">
                                    <div class="card-header">
                                        <h5 class="mb-0">Archivos Adjuntos</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="list-group">
                                            <t t-foreach="attachments" t-as="attachment">
                                                <a t-attf-href="/web/content/#{attachment.id}?download=true"
                                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <i class="fa fa-file-o me-2"/>
                                                        <span t-esc="attachment.name"/>
                                                    </div>
                                                    <span class="badge bg-primary rounded-pill">
                                                        <i class="fa fa-download"/>
                                                    </span>
                                                </a>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sidebar con información adicional -->
                            <div class="col-lg-4">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="mb-0">Estado de la Solicitud</h5>
                                    </div>
                                    <div class="card-body">
                                        <div t-attf-class="alert {{ 'alert-danger' if document.status == 'rejected' else ('alert-success' if document.status == 'approve' else 'alert-info') }}" role="alert">
                                            <strong>Estado Actual:</strong><br/>
                                            <span t-field="document.status" class="h5"/>
                                        </div>
                                        <p class="text-muted small">
                                            La solicitud será procesada por el equipo correspondiente.
                                            Recibirás una notificación cuando cambie el estado.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sección del Chatter (Historial de Mensajes) -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="mb-0">
                                            <i class="fa fa-comments me-2"/>Historial y Comunicación
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <!-- Formulario para enviar nuevos mensajes -->
                                        <div class="o_portal_chatter_composer mb-4 pb-4 border-bottom">
                                            <h6 class="mb-3">
                                                <i class="fa fa-pencil me-2"/>Enviar un mensaje
                                            </h6>
                                            <form method="POST" t-attf-action="/my/documents/#{document.id}/post_message">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="mb-3">
                                                    <textarea name="message"
                                                              class="form-control"
                                                              rows="4"
                                                              placeholder="Escribe tu mensaje o consulta aquí..."
                                                              required="required"></textarea>
                                                </div>
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fa fa-paper-plane me-1"/> Enviar Mensaje
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Mostrar mensajes existentes -->
                                        <h6 class="mb-3">
                                            <i class="fa fa-history me-2"/>Historial de Mensajes
                                        </h6>
                                        <t t-if="messages">
                                            <div class="o_portal_chatter_messages">
                                                <t t-foreach="messages" t-as="message">
                                                    <div class="o_portal_chatter_message mb-3 pb-3 border-bottom">
                                                        <div class="d-flex">
                                                            <div class="flex-shrink-0 me-3">
                                                                <img t-if="message['author_id'] and message['author_id']['id']"
                                                                     t-attf-src="/web/image/res.partner/#{message['author_id']['id']}/avatar_128"
                                                                     class="rounded-circle"
                                                                     style="width: 45px; height: 45px;"
                                                                     alt="Avatar"/>
                                                                <i t-else="" class="fa fa-user-circle fa-3x text-muted"/>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                                    <div>
                                                                        <strong t-if="message['author_id']" t-esc="message['author_id']['name']"/>
                                                                        <strong t-else="">Sistema</strong>
                                                                        <span class="text-muted small ms-2">
                                                                            <t t-esc="message['date']"/>
                                                                        </span>
                                                                    </div>
                                                                    <t t-if="message['message_type'] == 'notification'">
                                                                        <span class="badge bg-info">Notificación</span>
                                                                    </t>
                                                                    <t t-elif="message['message_type'] == 'comment'">
                                                                        <span class="badge bg-primary">Comentario</span>
                                                                    </t>
                                                                </div>
                                                                <div class="o_portal_chatter_message_body" t-raw="message['body']"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="alert alert-info" role="alert">
                                                <i class="fa fa-info-circle me-2"/>No hay mensajes en el historial. Sé el primero en escribir.
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>

