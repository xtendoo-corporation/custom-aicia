<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Breadcrumb para el detalle de solicitud -->
        <template id="portal_my_invoice_detail_breadcrumb" name="Portal: Detalle Solicitud de Factura"
                  inherit_id="portal.portal_breadcrumbs" priority="47">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'invoice_request' and invoice_request" class="breadcrumb-item">
                    <a t-attf-href="/my/invoices">Solicitudes de Facturas</a>
                </li>
                <li t-if="page_name == 'invoice_request' and invoice_request" class="breadcrumb-item active">
                    Solicitud #<span t-esc="invoice_request.id"/>
                </li>
            </xpath>
        </template>

        <!-- Vista de detalle de la solicitud de factura -->
        <template id="portal_my_invoice_detail" name="Detalle de Solicitud de Factura">
            <t t-call="portal.portal_layout">
                <div id="wrap" class="o_portal_wrap portal-detail-page">
                    <div class="container mt-3 portal-detail-page">
                        <!-- Mensajes de éxito -->
                        <div t-if="success_message == 'revision_requested'" class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>¡Solicitud enviada!</strong> Su solicitud de nueva revisión ha sido registrada correctamente.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                        <div t-if="success_message == 'message_posted'" class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>¡Mensaje enviado!</strong> Tu comentario ha sido publicado correctamente.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                        <div t-if="success_message == 'approved'" class="alert alert-success alert-dismissible fade show" role="alert">
                            <strong>¡Solicitud aprobada!</strong> La solicitud ha sido aprobada y enviada al responsable de clientes para su revisión.
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-3 portal-detail-toolbar">
                                    <h3>Solicitud de Factura #<span t-esc="invoice_request.id"/></h3>
                                    <div>
                                        <!-- Botón Ver Factura Creada -->
                                        <a t-if="invoice_request.status == 'approve' and invoice_request.invoice_created"
                                           t-attf-href="/my/invoices/#{invoice_request.id}/view_invoice"
                                           class="btn btn-success me-2">
                                            <i class="fa fa-file-text me-1"/> Ver Factura Creada
                                        </a>
                                        <!-- Botón Solicitar Revisión -->
                                        <form t-if="invoice_request.show_solicitar_revision"
                                              method="POST"
                                              t-attf-action="/my/invoices/#{invoice_request.id}/request_revision"
                                              class="d-inline-block me-2">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-warning">
                                                <i class="fa fa-refresh me-1"/> Solicitar Revisión
                                            </button>
                                        </form>
                                        <!-- Botón Aprobar (visible solo para el jefe de equipo) -->
                                        <form t-if="invoice_request.show_approve_button"
                                              method="POST"
                                              t-attf-action="/my/invoices/#{invoice_request.id}/approve"
                                              class="d-inline-block me-2">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <button type="submit" class="btn btn-success">
                                                <i class="fa fa-check me-1"/> Aprobar Solicitud
                                            </button>
                                        </form>
                                        <!-- Botón Volver -->
<!--                                        <a href="/my/invoices" class="btn btn-secondary">-->
<!--                                            <i class="fa fa-arrow-left"/> Volver al Listado-->
<!--                                        </a>-->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="card mb-3 portal-detail-main-card">
                                    <div class="card-header">
                                        <h5 class="mb-0">Información General</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Tipo:</strong>
                                                <p>
                                                    <span t-if="invoice_request.move_type == 'out_invoice'">Factura de Cliente</span>
                                                    <span t-else="">Factura Rectificativa</span>
                                                </p>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Estado:</strong>
                                                <p>
                                                    <span t-attf-class="badge {{ 'bg-danger' if invoice_request.status in ['to_revise', 'rejected'] else ('bg-success' if invoice_request.status == 'approve' else 'bg-info') }}">
                                                        <span t-field="invoice_request.status"/>
                                                    </span>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Cliente:</strong>
                                                <p><span t-field="invoice_request.partner_id"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Proyecto:</strong>
                                                <p><span t-field="invoice_request.analytic_id"/></p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Importe:</strong>
                                                <p><span t-field="invoice_request.amount" t-options='{"widget": "monetary", "display_currency": invoice_request.currency_id}'/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Usuario:</strong>
                                                <p><span t-field="invoice_request.user_id"/></p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Fecha:</strong>
                                                <p><span t-field="invoice_request.date"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Fecha de Creación:</strong>
                                                <p><span t-field="invoice_request.create_date" t-options='{"widget": "datetime"}'/></p>
                                            </div>
                                        </div>
                                        <div class="row mb-3" t-if="invoice_request.notes">
                                            <div class="col-12">
                                                <strong>Concepto de Factura:</strong>
                                                <p><span t-field="invoice_request.notes"/></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sección de adjuntos SIEMPRE visible -->
                                <div class="card mb-3">
                                    <div class="card-header">
                                        <h5 class="mb-0">Archivos Adjuntos</h5>
                                    </div>
                                    <div class="card-body">
                                        <!-- Formulario de subida de adjunto -->
                                        <form method="POST" enctype="multipart/form-data" t-attf-action="/my/invoices/#{invoice_request.id}/add_attachment" class="mb-3">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="input-group">
                                                <input type="file" name="attachment" class="form-control" accept="application/pdf" required="required"/>
                                                <button type="submit" class="btn btn-outline-primary">
                                                    <i class="fa fa-upload me-1"/> Subir archivo
                                                </button>
                                            </div>
                                        </form>
                                        <div class="list-group">
                                            <t t-if="attachments and len(attachments) &gt; 0">
                                                <t t-foreach="attachments" t-as="attachment">
                                                    <a t-attf-href="/web/content/#{attachment.id}?download=true"
                                                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <i class="fa fa-file-o me-2"/>
                                                            <span t-esc="attachment.name"/>
                                                        </div>
                                                        <span class="badge bg-primary rounded-pill">
                                                            <i class="fa fa-download"/>
                                                        </span>
                                                    </a>
                                                </t>
                                            </t>
                                            <t t-else="">
                                                <div class="alert alert-info mb-0">No hay archivos adjuntos aún.</div>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Sección del Chatter (Historial de Mensajes) -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="mb-0">
                                            <i class="fa fa-comments me-2"/>Historial y Comunicación
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <!-- Formulario para enviar nuevos mensajes -->
                                        <div class="o_portal_chatter_composer mb-4 pb-4 border-bottom">
                                            <h6 class="mb-3">
                                                <i class="fa fa-pencil me-2"/>Enviar un mensaje
                                            </h6>
                                            <form method="POST" t-attf-action="/my/invoices/#{invoice_request.id}/post_message">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="mb-3">
                                                    <textarea name="message"
                                                              class="form-control"
                                                              rows="4"
                                                              placeholder="Escribe tu mensaje o consulta aquí..."
                                                              required="required"></textarea>
                                                </div>
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fa fa-paper-plane me-1"/> Enviar Mensaje
                                                </button>
                                            </form>
                                        </div>

                                        <!-- Mostrar mensajes existentes -->
                                        <h6 class="mb-3">
                                            <i class="fa fa-history me-2"/>Historial de Mensajes
                                        </h6>
                                        <t t-if="messages">
                                            <div class="o_portal_chatter_messages">
                                                <t t-foreach="messages" t-as="message">
                                                    <div class="o_portal_chatter_message mb-3 pb-3 border-bottom">
                                                        <div class="d-flex">
                                                            <div class="flex-shrink-0 me-3">
                                                                <img t-if="message['author_id'] and message['author_id']['id']"
                                                                     t-attf-src="/web/image/res.partner/#{message['author_id']['id']}/avatar_128"
                                                                     class="rounded-circle"
                                                                     style="width: 45px; height: 45px;"
                                                                     alt="Avatar"/>
                                                                <i t-else="" class="fa fa-user-circle fa-3x text-muted"/>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                                    <div>
                                                                        <strong t-if="message['author_id']" t-esc="message['author_id']['name']"/>
                                                                        <strong t-else="">Sistema</strong>
                                                                        <span class="text-muted small ms-2">
                                                                            <t t-esc="message['date']"/>
                                                                        </span>
                                                                    </div>
                                                                    <t t-if="message['message_type'] == 'notification'">
                                                                        <span class="badge bg-info">Notificación</span>
                                                                    </t>
                                                                    <t t-elif="message['message_type'] == 'comment'">
                                                                        <span class="badge bg-primary">Comentario</span>
                                                                    </t>
                                                                </div>
                                                                <div class="o_portal_chatter_message_body" t-raw="message['body']"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="alert alert-info" role="alert">
                                                <i class="fa fa-info-circle me-2"/>No hay mensajes en el historial. Sé el primero en escribir.
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>

