<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Breadcrumb para el detalle de pago -->
        <template id="portal_my_payment_detail_breadcrumb" name="Portal: Detalle de Pago"
                  inherit_id="portal.portal_breadcrumbs" priority="47">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'payment' and payment" class="breadcrumb-item">
                    <a t-attf-href="/my/payments">Mis Pagos</a>
                </li>
                <li t-if="page_name == 'payment' and payment" class="breadcrumb-item active">
                    <span t-esc="payment.name"/>
                </li>
            </xpath>
        </template>

        <!-- Breadcrumb para la lista de pagos -->
        <template id="portal_my_payments_breadcrumb" name="Portal: Lista de Pagos"
                  inherit_id="portal.portal_breadcrumbs" priority="46">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'payments' and not payment" class="breadcrumb-item active">
                    Mis Pagos
                </li>
            </xpath>
        </template>

        <!-- Detalle de Pago -->
        <template id="portal_my_payment_detail" name="Detalle de Pago">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                <t t-call="portal.portal_breadcrumbs"/>
                <div class="card mt-3">
                    <div class="card-header">
                        <h4>Detalle del Pago <span t-esc="payment.name"/></h4>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-3">Referencia</dt>
                            <dd class="col-sm-9"><span t-esc="payment.name"/></dd>
                            <dt class="col-sm-3">Fecha</dt>
                            <dd class="col-sm-9"><span t-esc="payment.date"/></dd>
                            <dt class="col-sm-3">Importe</dt>
                            <dd class="col-sm-9"><span t-esc="payment.amount"/></dd>
                            <dt class="col-sm-3">Estado</dt>
                            <dd class="col-sm-9"><span t-esc="payment.state"/></dd>
                            <dt class="col-sm-3">Factura</dt>
                            <dd class="col-sm-9">
                                <t t-if="payment.invoice_ids">
                                    <t t-foreach="payment.invoice_ids" t-as="inv" t-separator=", ">
                                        <span t-esc="inv.name"/>
                                    </t>
                                </t>
                                <t t-if="not payment.invoice_ids">
                                    -
                                </t>
                            </dd>
                        </dl>
                    </div>
                </div>
                <!-- Sección de adjuntos (copia literal de factura) -->
                <div class="card mb-3" t-if="attachments">
                    <div class="card-header">
                        <h5 class="mb-0">Archivos Adjuntos</h5>
                    </div>
                    <div class="card-body">
                        <!-- Formulario de subida de adjunto -->
                        <form method="POST" enctype="multipart/form-data" t-attf-action="/my/payments/#{payment.id}/add_attachment" class="mb-3">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="input-group">
                                <input type="file" name="attachment" class="form-control" required="required"/>
                                <button type="submit" class="btn btn-outline-primary">
                                    <i class="fa fa-upload me-1"/> Subir archivo
                                </button>
                            </div>
                        </form>
                        <div class="list-group">
                            <t t-foreach="attachments" t-as="attachment">
                                <a t-attf-href="/web/content/#{attachment.id}?download=true"
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="fa fa-file-o me-2"/>
                                        <span t-esc="attachment.name"/>
                                    </div>
                                    <span class="badge bg-primary rounded-pill">
                                        <i class="fa fa-download"/>
                                    </span>
                                </a>
                            </t>
                        </div>
                    </div>
                </div>
                <!-- Sección del Chatter (copia literal de factura, adaptando variable a 'payment') -->
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 class="mb-0">
                                    <i class="fa fa-comments me-2"/>Historial y Comunicación
                                </h5>
                            </div>
                            <div class="card-body">
                                <!-- Formulario para enviar nuevos mensajes (opcional, si se desea igualar literal) -->
                                <div class="o_portal_chatter_composer mb-4 pb-4 border-bottom">
                                    <h6 class="mb-3">
                                        <i class="fa fa-pencil me-2"/>Enviar un mensaje
                                    </h6>
                                    <form method="POST" t-attf-action="/my/payments/#{payment.id}/post_message">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <textarea name="message"
                                                      class="form-control"
                                                      rows="4"
                                                      placeholder="Escribe tu mensaje o consulta aquí..."
                                                      required="required"></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-primary">
                                            <i class="fa fa-paper-plane me-1"/> Enviar Mensaje
                                        </button>
                                    </form>
                                </div>
                                <!-- Mostrar mensajes existentes -->
                                <h6 class="mb-3">
                                    <i class="fa fa-history me-2"/>Historial de Mensajes
                                </h6>
                                <t t-if="messages">
                                    <div class="o_portal_chatter_messages">
                                        <t t-foreach="messages" t-as="message">
                                            <div class="o_portal_chatter_message mb-3 pb-3 border-bottom">
                                                <div class="d-flex">
                                                    <div class="flex-shrink-0 me-3">
                                                        <img t-if="message['author_id'] and message['author_id']['id']"
                                                             t-attf-src="/web/image/res.partner/#{message['author_id']['id']}/avatar_128"
                                                             class="rounded-circle"
                                                             style="width: 45px; height: 45px;"
                                                             alt="Avatar"/>
                                                        <i t-else="" class="fa fa-user-circle fa-3x text-muted"/>
                                                    </div>
                                                    <div class="flex-grow-1">
                                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                                            <div>
                                                                <strong t-if="message['author_id']" t-esc="message['author_id']['name']"/>
                                                                <strong t-else="">Sistema</strong>
                                                                <span class="text-muted small ms-2">
                                                                    <t t-esc="message['date']"/>
                                                                </span>
                                                            </div>
                                                            <t t-if="message['message_type'] == 'notification'">
                                                                <span class="badge bg-info">Notificación</span>
                                                            </t>
                                                            <t t-elif="message['message_type'] == 'comment'">
                                                                <span class="badge bg-primary">Comentario</span>
                                                            </t>
                                                        </div>
                                                        <div class="o_portal_chatter_message_body" t-raw="message['body']"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="alert alert-info" role="alert">
                                        <i class="fa fa-info-circle me-2"/>No hay mensajes en el historial. Sé el primero en escribir.
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>
    </data>
</odoo>

