<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Breadcrumb para el detalle de pago -->
        <template id="portal_my_payment_detail_breadcrumb" name="Portal: Detalle de Pago"
                  inherit_id="portal.portal_breadcrumbs" priority="47">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'payment' and payment" class="breadcrumb-item">
                    <a t-attf-href="/my/payments">Mis Pagos</a>
                </li>
                <li t-if="page_name == 'payment' and payment" class="breadcrumb-item active">
                    <span t-esc="payment.name"/>
                </li>
            </xpath>
        </template>

        <!-- Breadcrumb para la lista de pagos -->
        <template id="portal_my_payments_breadcrumb" name="Portal: Lista de Pagos"
                  inherit_id="portal.portal_breadcrumbs" priority="46">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'payments' and not payment" class="breadcrumb-item active">
                    Mis Pagos
                </li>
            </xpath>
        </template>

        <!-- Detalle de Pago -->
        <template id="portal_my_payment_detail" name="Detalle de Pago">
            <t t-call="portal.portal_layout">
                <div id="wrap" class="o_portal_wrap portal-detail-page">
                    <div class="container mt-3 portal-detail-page">
                        <div class="row">
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center mb-3 portal-detail-toolbar">
                                    <h3>Detalle del Pago <span t-esc="payment.name"/></h3>
                                    <div>
                                        <a t-if="payment_visible_invoices"
                                           t-attf-href="/my/payments/#{payment.id}/invoices_list"
                                           class="btn btn-light btn-sm">
                                            <i class="fa fa-file-invoice me-1"/> Ver Facturas Asociadas
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-12">
                                <div class="card mb-3 portal-detail-main-card">
                                    <div class="card-header">
                                        <h5 class="mb-0">Información General</h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Referencia:</strong>
                                                <p><span t-esc="payment.name"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Estado:</strong>
                                                <p>
                                                    <span t-if="payment.state == 'draft'" class="badge bg-secondary">Borrador</span>
                                                    <span t-elif="payment.state == 'in_process'" class="badge bg-warning">En proceso</span>
                                                    <span t-elif="payment.state == 'paid'" class="badge bg-success">Pagado</span>
                                                    <span t-elif="payment.state == 'posted'" class="badge bg-primary">Publicado</span>
                                                    <span t-elif="payment.state in ['cancel', 'cancelled']" class="badge bg-danger">Cancelado</span>
                                                    <span t-else="" class="badge bg-info" t-esc="payment.state"/>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-md-6">
                                                <strong>Fecha:</strong>
                                                <p><span t-field="payment.date"/></p>
                                            </div>
                                            <div class="col-md-6">
                                                <strong>Importe:</strong>
                                                <p>
                                                    <span t-field="payment.amount" t-options='{"widget": "monetary", "display_currency": payment.currency_id}'/>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="row mb-3">
                                            <div class="col-12">
                                                <strong>Factura:</strong>
                                                <p>
                                                    <t t-if="payment_visible_invoices">
                                                        <t t-foreach="payment_visible_invoices" t-as="inv" t-separator=", ">
                                                            <a t-attf-href="/my/payments/#{payment.id}/invoices_list/#{inv.id}">
                                                                <span t-esc="inv.name"/>
                                                            </a>
                                                        </t>
                                                    </t>
                                                    <t t-else="">-</t>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="card mb-3">
                                    <div class="card-header">
                                        <h5 class="mb-0">Archivos Adjuntos</h5>
                                    </div>
                                    <div class="card-body">
                                        <form method="POST" enctype="multipart/form-data" t-attf-action="/my/payments/#{payment.id}/add_attachment" class="mb-3">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <div class="input-group">
                                                <input type="file" name="attachment" class="form-control" accept="application/pdf" required="required"/>
                                                <button type="submit" class="btn btn-outline-primary">
                                                    <i class="fa fa-upload me-1"/> Subir archivo
                                                </button>
                                            </div>
                                        </form>
                                        <t t-if="attachments and len(attachments) &gt; 0">
                                            <div class="list-group">
                                                <t t-foreach="attachments" t-as="attachment">
                                                    <a t-attf-href="/web/content/#{attachment.id}?download=true"
                                                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                                        <div>
                                                            <i class="fa fa-file-o me-2"/>
                                                            <span t-esc="attachment.name"/>
                                                        </div>
                                                        <span class="badge bg-primary rounded-pill">
                                                            <i class="fa fa-download"/>
                                                        </span>
                                                    </a>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="alert alert-info mb-0" role="alert">
                                                <i class="fa fa-info-circle me-2"/>
                                                No hay archivos adjuntos en este pago.
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h5 class="mb-0">
                                            <i class="fa fa-comments me-2"/>Historial y Comunicación
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="o_portal_chatter_composer mb-4 pb-4 border-bottom">
                                            <h6 class="mb-3">
                                                <i class="fa fa-pencil me-2"/>Enviar un mensaje
                                            </h6>
                                            <form method="POST" t-attf-action="/my/payments/#{payment.id}/post_message">
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                <div class="mb-3">
                                                    <textarea name="message"
                                                              class="form-control"
                                                              rows="4"
                                                              placeholder="Escribe tu mensaje o consulta aquí..."
                                                              required="required"></textarea>
                                                </div>
                                                <button type="submit" class="btn btn-primary">
                                                    <i class="fa fa-paper-plane me-1"/> Enviar Mensaje
                                                </button>
                                            </form>
                                        </div>
                                        <h6 class="mb-3">
                                            <i class="fa fa-history me-2"/>Historial de Mensajes
                                        </h6>
                                        <t t-if="messages">
                                            <div class="o_portal_chatter_messages">
                                                <t t-foreach="messages" t-as="message">
                                                    <div class="o_portal_chatter_message mb-3 pb-3 border-bottom">
                                                        <div class="d-flex">
                                                            <div class="flex-shrink-0 me-3">
                                                                <img t-if="message['author_id'] and message['author_id']['id']"
                                                                     t-attf-src="/web/image/res.partner/#{message['author_id']['id']}/avatar_128"
                                                                     class="rounded-circle"
                                                                     style="width: 45px; height: 45px;"
                                                                     alt="Avatar"/>
                                                                <i t-else="" class="fa fa-user-circle fa-3x text-muted"/>
                                                            </div>
                                                            <div class="flex-grow-1">
                                                                <div class="d-flex justify-content-between align-items-start mb-2">
                                                                    <div>
                                                                        <strong t-if="message['author_id']" t-esc="message['author_id']['name']"/>
                                                                        <strong t-else="">Sistema</strong>
                                                                        <span class="text-muted small ms-2">
                                                                            <t t-esc="message['date']"/>
                                                                        </span>
                                                                    </div>
                                                                    <t t-if="message['message_type'] == 'notification'">
                                                                        <span class="badge bg-info">Notificación</span>
                                                                    </t>
                                                                    <t t-elif="message['message_type'] == 'comment'">
                                                                        <span class="badge bg-primary">Comentario</span>
                                                                    </t>
                                                                </div>
                                                                <div class="o_portal_chatter_message_body" t-raw="message['body']"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="alert alert-info" role="alert">
                                                <i class="fa fa-info-circle me-2"/>No hay mensajes en el historial. Sé el primero en escribir.
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_payment_invoices" name="Facturas del Pago">
            <t t-call="portal.portal_layout">
                <t t-set="no_breadcrumbs" t-value="True"/>

                <div class="container">
                    <div class="row mt-3">
                        <div class="col-12">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/my"><i class="fa fa-home"/></a></li>
                                <li class="breadcrumb-item"><a href="/my/payments">Mis Pagos</a></li>
                                <li class="breadcrumb-item"><a t-attf-href="/my/payments/#{payment.id}"><span t-esc="payment.name"/></a></li>
                                <li class="breadcrumb-item active" aria-current="page">Facturas Asociadas</li>
                            </ol>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card mb-4">
                                <div class="card-header bg-primary text-white">
                                    <h4 class="mb-0">
                                        <i class="fa fa-file-invoice me-2"></i>
                                        Facturas del Pago: <span t-esc="payment.name"/>
                                    </h4>
                                </div>
                                <div class="card-body">
                                    <t t-if="not invoices">
                                        <div class="alert alert-info" role="alert">
                                            No hay facturas asociadas a este pago.
                                        </div>
                                    </t>
                                    <t t-if="invoices">
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Número</th>
                                                        <th>Tipo</th>
                                                        <th>Cliente/Proveedor</th>
                                                        <th>Fecha</th>
                                                        <th>Importe Total</th>
                                                        <th>Estado</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="invoices" t-as="invoice">
                                                        <tr>
                                                            <td>
                                                                <a t-attf-href="/my/payments/#{payment.id}/invoices_list/#{invoice.id}">
                                                                    <span t-esc="invoice.name"/>
                                                                </a>
                                                            </td>
                                                            <td>
                                                                <span t-if="invoice.move_type == 'out_invoice'">Factura Cliente</span>
                                                                <span t-elif="invoice.move_type == 'out_refund'">Nota Crédito Cliente</span>
                                                                <span t-elif="invoice.move_type == 'in_invoice'">Factura Proveedor</span>
                                                                <span t-elif="invoice.move_type == 'in_refund'">Nota Crédito Proveedor</span>
                                                            </td>
                                                            <td>
                                                                <span t-esc="invoice.partner_id.name"/>
                                                            </td>
                                                            <td>
                                                                <span t-field="invoice.invoice_date"/>
                                                            </td>
                                                            <td>
                                                                <span t-field="invoice.amount_total"
                                                                      t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                            </td>
                                                            <td>
                                                                <span t-if="invoice.payment_state == 'paid'" class="badge bg-success">Pagada</span>
                                                                <span t-elif="invoice.payment_state == 'partial'" class="badge bg-warning">Pago Parcial</span>
                                                                <span t-elif="invoice.state == 'posted'" class="badge bg-info">Publicada</span>
                                                                <span t-elif="invoice.state == 'draft'" class="badge bg-secondary">Borrador</span>
                                                                <span t-else="" class="badge bg-secondary" t-esc="invoice.state"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <a t-attf-href="/my/payments/#{payment.id}" class="btn btn-secondary">
                                <i class="fa fa-arrow-left me-2"></i>
                                Volver al Pago
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_payment_invoice_detail" name="Detalle de Factura del Pago">
            <t t-call="portal.portal_layout">
                <t t-set="no_breadcrumbs" t-value="True"/>

                <div class="container">
                    <div class="row mt-3">
                        <div class="col-12">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/my"><i class="fa fa-home"/></a></li>
                                <li class="breadcrumb-item"><a href="/my/payments">Mis Pagos</a></li>
                                <li class="breadcrumb-item"><a t-attf-href="/my/payments/#{payment.id}"><span t-esc="payment.name"/></a></li>
                                <li class="breadcrumb-item"><a t-attf-href="/my/payments/#{payment.id}/invoices_list">Facturas</a></li>
                                <li class="breadcrumb-item active" aria-current="page">
                                    <span t-esc="invoice.name"/>
                                </li>
                            </ol>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card mb-4">
                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                    <h4 class="mb-0">
                                        <i class="fa fa-file-invoice me-2"></i>
                                        Factura: <span t-esc="invoice.name"/>
                                    </h4>
                                    <a t-if="invoice_payments"
                                       t-attf-href="/my/payments/#{payment.id}/invoices_list/#{invoice.id}/payments_list"
                                       class="btn btn-light btn-sm">
                                        <i class="fa fa-credit-card me-1"></i>
                                        Ver Pagos Asociados
                                    </a>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <strong>Tipo de Documento:</strong>
                                                <p>
                                                    <span t-if="invoice.move_type == 'out_invoice'" class="badge bg-primary">Factura Cliente</span>
                                                    <span t-elif="invoice.move_type == 'out_refund'" class="badge bg-warning">Nota Crédito Cliente</span>
                                                    <span t-elif="invoice.move_type == 'in_invoice'" class="badge bg-info">Factura Proveedor</span>
                                                    <span t-elif="invoice.move_type == 'in_refund'" class="badge bg-secondary">Nota Crédito Proveedor</span>
                                                </p>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Cliente/Proveedor:</strong>
                                                <p><span t-esc="invoice.partner_id.name"/></p>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Fecha de Factura:</strong>
                                                <p><span t-field="invoice.invoice_date"/></p>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Fecha de Vencimiento:</strong>
                                                <p>
                                                    <span t-if="invoice.invoice_date_due" t-field="invoice.invoice_date_due"/>
                                                    <span t-else="">-</span>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <strong>Estado:</strong>
                                                <p>
                                                    <span t-if="invoice.state == 'draft'" class="badge bg-secondary">Borrador</span>
                                                    <span t-elif="invoice.state == 'posted'" class="badge bg-success">Publicada</span>
                                                    <span t-elif="invoice.state == 'cancel'" class="badge bg-danger">Cancelada</span>
                                                    <span t-else="" class="badge bg-info" t-esc="invoice.state"/>
                                                </p>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Estado de Pago:</strong>
                                                <p>
                                                    <span t-if="invoice.payment_state == 'paid'" class="badge bg-success">Pagada</span>
                                                    <span t-elif="invoice.payment_state == 'partial'" class="badge bg-warning">Pago Parcial</span>
                                                    <span t-elif="invoice.payment_state == 'not_paid'" class="badge bg-danger">No Pagada</span>
                                                    <span t-else="" class="badge bg-secondary" t-esc="invoice.payment_state"/>
                                                </p>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Base Imponible:</strong>
                                                <p>
                                                    <span t-field="invoice.amount_untaxed"
                                                          t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                </p>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Impuestos:</strong>
                                                <p>
                                                    <span t-field="invoice.amount_tax"
                                                          t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                </p>
                                            </div>
                                            <div class="mb-3">
                                                <strong>Total:</strong>
                                                <p>
                                                    <strong>
                                                        <span t-field="invoice.amount_total"
                                                              t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                    </strong>
                                                </p>
                                            </div>
                                        </div>
                                    </div>

                                    <hr/>
                                    <h5 class="mb-3">Líneas de Factura</h5>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-striped">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Descripción</th>
                                                    <th class="text-end">Cantidad</th>
                                                    <th class="text-end">Precio Unitario</th>
                                                    <th class="text-end">Impuestos</th>
                                                    <th class="text-end">Subtotal</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="invoice.invoice_line_ids" t-as="line">
                                                    <tr t-if="line.display_type == 'product'">
                                                        <td><span t-esc="line.name"/></td>
                                                        <td class="text-end"><span t-esc="line.quantity"/></td>
                                                        <td class="text-end">
                                                            <span t-field="line.price_unit"
                                                                  t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </td>
                                                        <td class="text-end">
                                                            <span t-esc="', '.join(line.tax_ids.mapped('name')) if line.tax_ids else '-'"/>
                                                        </td>
                                                        <td class="text-end">
                                                            <span t-field="line.price_subtotal"
                                                                  t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <a t-attf-href="/my/payments/#{payment.id}/invoices_list" class="btn btn-secondary">
                                <i class="fa fa-arrow-left me-2"></i>
                                Volver a Facturas
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <template id="portal_invoice_payments" name="Pagos de la Factura">
            <t t-call="portal.portal_layout">
                <t t-set="no_breadcrumbs" t-value="True"/>

                <div class="container">
                    <div class="row mt-3">
                        <div class="col-12">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/my"><i class="fa fa-home"/></a></li>
                                <li class="breadcrumb-item"><a href="/my/payments">Mis Pagos</a></li>
                                <li class="breadcrumb-item"><a t-attf-href="/my/payments/#{payment.id}"><span t-esc="payment.name"/></a></li>
                                <li class="breadcrumb-item"><a t-attf-href="/my/payments/#{payment.id}/invoices_list">Facturas</a></li>
                                <li class="breadcrumb-item"><a t-attf-href="/my/payments/#{payment.id}/invoices_list/#{invoice.id}"><span t-esc="invoice.name"/></a></li>
                                <li class="breadcrumb-item active" aria-current="page">Pagos Asociados</li>
                            </ol>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <div class="card mb-4">
                                <div class="card-header bg-primary text-white">
                                    <h4 class="mb-0">
                                        <i class="fa fa-credit-card me-2"></i>
                                        Pagos de la Factura: <span t-esc="invoice.name"/>
                                    </h4>
                                </div>
                                <div class="card-body">
                                    <t t-if="not payments">
                                        <div class="alert alert-info" role="alert">
                                            No hay pagos asociados a esta factura.
                                        </div>
                                    </t>
                                    <t t-if="payments">
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>Referencia</th>
                                                        <th>Fecha</th>
                                                        <th>Importe</th>
                                                        <th>Estado</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="payments" t-as="pay">
                                                        <tr>
                                                            <td>
                                                                <a t-attf-href="/my/payments/#{pay.id}">
                                                                    <span t-esc="pay.name"/>
                                                                </a>
                                                            </td>
                                                            <td>
                                                                <span t-field="pay.date"/>
                                                            </td>
                                                            <td>
                                                                <span t-field="pay.amount" t-options='{"widget": "monetary", "display_currency": pay.currency_id}'/>
                                                            </td>
                                                            <td>
                                                                <span t-if="pay.state == 'draft'" class="badge bg-secondary">Borrador</span>
                                                                <span t-elif="pay.state == 'in_process'" class="badge bg-warning">En proceso</span>
                                                                <span t-elif="pay.state == 'paid'" class="badge bg-success">Pagado</span>
                                                                <span t-elif="pay.state == 'posted'" class="badge bg-primary">Publicado</span>
                                                                <span t-elif="pay.state in ['cancel', 'cancelled']" class="badge bg-danger">Cancelado</span>
                                                                <span t-else="" class="badge bg-info" t-esc="pay.state"/>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <a t-attf-href="/my/payments/#{payment.id}/invoices_list/#{invoice.id}" class="btn btn-secondary">
