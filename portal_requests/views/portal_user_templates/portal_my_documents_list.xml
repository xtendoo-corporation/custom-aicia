<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Breadcrumb para navegación -->
        <template id="portal_my_home_menu_documents" name="Portal layout: menu documents"
                  inherit_id="portal.portal_breadcrumbs" priority="48">
            <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
                <li t-if="page_name == 'document_approval' and not document" class="breadcrumb-item active">
                    Solicitudes de Documentos
                </li>
            </xpath>
        </template>

        <!-- Vista del listado de solicitudes de documentos -->
        <template id="portal_my_documents" name="Mis Solicitudes de Documentos">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <t t-call="portal.portal_searchbar">
                        <t t-set="title">Solicitudes de Documentos</t>
                    </t>
                    <a href="/portal/approval_request" class="btn btn-primary ms-3">
                        <i class="fa fa-plus me-2"></i>Nueva Solicitud
                    </a>
                </div>

                <t t-if="not documents">
                    <div class="alert alert-info mt-3" role="alert">
                        No hay solicitudes de documentos.
                    </div>
                </t>

                <t t-if="documents" t-call="portal.portal_table">
                    <thead>
                        <tr class="active">
                            <th>Tipo</th>
                            <th>Descripción</th>
                            <th>Grupo de Trabajo</th>
                            <th>Estado</th>
                            <th class="text-end">Fecha de Creación</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="documents" t-as="document">
                            <tr style="cursor: pointer;">
                                <td>
                                    <a t-attf-href="/my/documents/#{document.id}">
                                        <span t-field="document.type_id"/>
                                    </a>
                                </td>
                                <td>
                                    <a t-attf-href="/my/documents/#{document.id}">
                                        <span t-field="document.description"/>
                                    </a>
                                </td>
                                <td>
                                    <a t-attf-href="/my/documents/#{document.id}">
                                        <span t-field="document.work_group_id"/>
                                    </a>
                                </td>
                                <td>
                                    <a t-attf-href="/my/documents/#{document.id}">
                                        <span t-field="document.status"/>
                                    </a>
                                </td>
                                <td class="text-end">
                                    <a t-attf-href="/my/documents/#{document.id}">
                                        <span t-field="document.create_date" t-options='{"widget": "date"}'/>
                                    </a>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </t>
            </t>
        </template>
    </data>
</odoo>

