<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_certificate_form_inherit_users" model="ir.ui.view">
        <field name="name">report.certificate.form.inherit.users</field>
        <field name="model">report.certificate</field>
        <field name="inherit_id" ref="report_qweb_signer.view_report_certificate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="Usuarios autorizados">
                    <field name="user_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
        <!-- Herencia para la vista de árbol -->
    <record id="view_report_certificate_tree_inherit" model="ir.ui.view">
        <field name="name">report.certificate.tree.inherit</field>
        <field name="model">report.certificate</field>
        <field name="inherit_id" ref="report_qweb_signer.view_report_certificate_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="user_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
