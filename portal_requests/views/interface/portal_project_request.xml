<odoo>
    <data>
        <record id="view_portal_project_request_tree" model="ir.ui.view">
            <field name="name">portal.project.request.tree</field>
            <field name="model">portal.project.request</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="project_name"/>
                    <field name="user_id"/>
                    <field name="company_id"/>
                    <field name="work_group_id"/>
                    <field name="partner_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="type"/>
                    <field name="concept"/>
                    <field name="approved"/>
                    <field name="is_revised"/>
                </tree>
            </field>
        </record>

        <record id="view_portal_project_request_form" model="ir.ui.view">
            <field name="name">portal.project.request.form</field>
            <field name="model">portal.project.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                                invisible="is_revised == True"/>
                        <button name="action_reject"
                                string="Reject"
                                type="object"
                                class="btn-secondary"
                                invisible="is_revised == True"/>
                        <button name="action_to_revise"
                                string="Para Revisar"
                                type="object"
                                class="btn-secondary"
                                invisible="not is_revised or approved"/>
                    </header>
                    <sheet>
                        <div class="ribbon ribbon-top-right" invisible="not approved">
                            <span class="bg-success">Aprobada</span>
                        </div>
                        <div class="ribbon ribbon-top-right" invisible="approved or not is_revised">
                            <span class="bg-danger">Rechazada</span>
                        </div>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_analytic" type="object" class="oe_stat_button" icon="fa-sharp fa-thin fa-building" invisible="not created_analytic_id">
                                <field name="project_count" widget="statinfo" string="Cuenta Analítica"/>
                            </button>
                            <button name="action_view_dms_documents" type="object" class="oe_stat_button" icon="fa-solid fa-folder-open" invisible="not created_analytic_id or dms_document_count == 0">
                                <field name="dms_document_count" widget="statinfo" string="Documentos DMS"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="type" invisible="1"/>
                                <span invisible="type != 'new'">Apertura de nuevo proyecto</span>
                                <span invisible="type != 'end'">Finalización de proyecto</span>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="project_name"/>
                                <field name="work_group_id" invisible="type == 'end'"/>
                                <field name="partner_id_char" string="Cliente sugerido" invisible="type == 'end'"/>
                                <field name="partner_id" invisible="type == 'end'"/>
                                <field name="approved" invisible="1"/>
                                <field name="is_revised" invisible="1"/>
                                <field name="created_analytic_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="date_start" invisible="type == 'end'"/>
                                <field name="date_end"/>
                                <field name="type" invisible="1"/>
                                <field name="company_id"/>
                                <field name="user_id"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="action_portal_project_request_all" model="ir.actions.act_window">
            <field name="name">Proyectos</field>
            <field name="res_model">portal.project.request</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'group_by': 'company_id'}</field>
        </record>

        <record id="action_portal_project_request_approved" model="ir.actions.act_window">
            <field name="name">Approved</field>
            <field name="res_model">portal.project.request</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('approved', '=', True)]</field>
            <field name="context">{'group_by': 'company_id'}</field>
        </record>

        <record id="view_portal_project_request_search" model="ir.ui.view">
            <field name="name">portal.project.request.search</field>
            <field name="model">portal.project.request</field>
            <field name="arch" type="xml">
                <search string="Proyectos">
                    <field name="is_revised"/>
                    <filter string="Para revisar" name="approved_filter" domain="[('is_revised', '=', False)]"/>
                    <field name="approved"/>
                    <filter string="Aprobados" name="approved_filter" domain="[('approved', '=', True)]"/>
                    <field name="approved"/>
                    <filter string="Rechazados" name="rejected_filter" domain="[('approved', '=', False), ('is_revised', '=', True)]"/>
                    <field name="type"/>
                    <filter string="Nuevos Proyectos" name="new_filter" domain="[('type', '=', 'new')]"/>
                    <field name="type"/>
                    <filter string="Finalizar Proyectos" name="end_filter" domain="[('type', '=', 'end')]"/>
                </search>
            </field>
        </record>


        <record id="action_portal_project_request_notapproved" model="ir.actions.act_window">
            <field name="name">Not approved</field>
            <field name="res_model">portal.project.request</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_revised', '=', True), ('approved', '=', False)]</field>
            <field name="context">{'group_by': 'company_id'}</field>
        </record>

        <menuitem id="menu_portal_project_request_all"
                  name="Proyectos"
                  parent="portal_requests.portal_requests_menu"
                  action="action_portal_project_request_all"
                  groups="portal_requests.group_director_investigation_and_development"
                  sequence="20"/>

