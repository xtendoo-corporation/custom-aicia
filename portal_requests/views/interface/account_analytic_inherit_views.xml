<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_account_form_inherit" model="ir.ui.view">
        <field name="name">account.analytic.account.form.inherit</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="replace">
                <field name="user_can_edit" invisible="1"/>
                <field name="name" class="oe_inline" placeholder="e.g. Project XYZ" readonly="not user_can_edit"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="replace">
                <field name="partner_id" readonly="not user_can_edit"/>
            </xpath>
            <xpath expr="//field[@name='code']" position="replace">
                <field name="code" readonly="not user_can_edit"/>
            </xpath>
            <xpath expr="//field[@name='plan_id']" position="replace">
                <field name="plan_id" readonly="not user_can_edit"/>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="replace">
                <field name="company_id" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="replace">
                <field name="currency_id" options="{'no_create': True}" groups="base.group_multi_currency" readonly="not user_can_edit"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="clientes_asociados_domain" invisible="1"/>
                <field name="clientes_asociados" widget="many2many_tags" readonly="not user_can_edit"/>
                <field name="work_group_id" readonly="not user_can_edit"/>
                <field name="responsible_domain" invisible="1"/>
                <field name="responsible_id" readonly="not user_can_edit"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- Smart button de adjuntos con icono Odoo -->
                <button name="action_open_attachments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-paperclip "
                        invisible="attachment_count == 0">
                        <field name="attachment_count" widget="statinfo" string="Adjuntos" />
                    </button>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_account_list_inherit" model="ir.ui.view">
        <field name="name">account.analytic.account.list.inherit</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="work_group_id"/>
            </xpath>
        </field>
    </record>
</odoo>
