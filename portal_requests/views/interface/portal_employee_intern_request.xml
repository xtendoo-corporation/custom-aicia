<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_portal_hr_employee_internrequest_tree" model="ir.ui.view">
            <field name="name">portal.hr.employee.intern.request.tree</field>
            <field name="model">portal.hr.employee.intern.request</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name" string="Nombre"/>
                    <field name="company_id" string="Grupo de trabajo"/>
                    <field name="type" string="Tipo"/>
<!--                    <field name="identification_id" string="Identificación"/>-->
<!--                    <field name="mobile_phone" String="Móvil"/>-->
<!--                    <field name="ssnid"/>-->
<!--                    <field name="work_email" string="Email de trabajo"/>-->
<!--                    <field name="salary" string="Salario"/>-->
<!--                    <field name="number_of_pays" string="Número de pagos"/>-->
<!--                    <field name="resource_calendar_id"/>-->
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_portal_hr_employee_internrequest_form" model="ir.ui.view">
            <field name="name">portal.hr.employee.intern.request.form</field>
            <field name="model">portal.hr.employee.intern.request</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                                invisible="is_revised == True"/>
                        <button name="action_reject"
                                string="Reject"
                                type="object"
                                class="btn-secondary"
                                invisible="is_revised == True"/>
                        <button name="action_to_revise"
                                string="Para Revisar"
                                type="object"
                                class="btn-secondary"
                                invisible="not is_revised or approved"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_employee" type="object" class="oe_stat_button" icon="fa-solid fa-user" invisible="not employee_created">
                                <field name="employee_count" widget="statinfo" string="Becario"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name" string="Nombre"/>
                                <field name="company_id" string="Grupo de trabajo" readonly="1"/>
                                <field name="employee_created" invisible="1"/>
<!--                                <div invisible="type != 'new'">-->
                                <!--Nuevo becario -->
                                    <field name="identification_id" string="Identificación" invisible="type != 'new'"/>
                                    <field name="mobile_phone" String="Móvil" invisible="type != 'new'"/>
                                    <field name="ssnid" invisible="type != 'new'"/>
                                    <field name="work_email" string="Email de trabajo" invisible="type != 'new'"/>
                                <!--Fin nuevo becario -->
                                <!-- Alta Becario -->
                                <field name="alta_date" invisible="type != 'alta'"/>
                                <!-- Fin alta becario -->

                                <!-- Baja Becario -->
                                <field name="baja_date" invisible="type != 'baja'"/>
                                <field name="baja_reason_id" string="Motivo" invisible="type != 'baja'"/>

                                <!-- Fin baja becario -->

                            </group>
                            <group>
                                <field name="type" string="Tipo de solicitud" readonly="1"/>
                                <field name="baja_description" invisible="type != 'baja'"/>
                                <field name="is_revised" invisible="0"/>
                                <field name="approved" invisible="0"/>
                                <field name="salary" string="Salario" invisible="type != 'new'"/>
                                <field name="number_of_pays" string="Número de pagos" invisible="type != 'new'"/>
                                <field name="resource_calendar_id" invisible="type != 'new'"/>
                                <field name="confidential_compromise" invisible="type != 'new'"/>
                                <field name="bank_account" invisible="type != 'new'"/>
                            </group>
<!--                            <group invisible="type != 'new'">-->
<!--                            <group>-->
<!--                                <group>-->
<!--&lt;!&ndash;                                    <field name="identification_id"/>&ndash;&gt;-->
<!--&lt;!&ndash;                                    <field name="mobile_phone"/>&ndash;&gt;-->
<!--&lt;!&ndash;                                    <field name="ssnid"/>&ndash;&gt;-->
<!--&lt;!&ndash;                                    <field name="work_email"/>&ndash;&gt;-->
<!--                                </group>-->
<!--                                <group>-->
<!--                                    <field name="salary"/>-->
<!--                                    <field name="number_of_pays"/>-->
<!--                                    <field name="resource_calendar_id"/>-->
<!--                                </group>-->
<!--                                <field name="confidential_compromise"/>-->
<!--                                <field name="working_life_report" filename="working_life_report_filename"/>-->
<!--                                <field name="cv" filename="cv_filename"/>-->
<!--                                <field name="prl_annex" filename="prl_annex_filename"/>-->
<!--                                <field name="bank_account"/>-->
<!--                                <field name="is_revised" invisible="0"/>-->
<!--                                <field name="approved" invisible="0"/>-->
<!--                            </group>-->
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

         <record id="view_portal_employee_internrequest_search" model="ir.ui.view">
            <field name="name">portal.employee.intern.request.search</field>
            <field name="model">portal.hr.employee.intern.request</field>
            <field name="arch" type="xml">
                <search string="Empleados">
                    <field name="is_revised"/>
                    <filter string="Para revisar" name="approved_filter" domain="[('is_revised', '=', False)]"/>
                    <field name="approved"/>
                    <filter string="Aprobados" name="approved_filter" domain="[('approved', '=', True)]"/>
                    <field name="approved"/>
                    <filter string="Rechazados" name="rejected_filter" domain="[('approved', '=', False), ('is_revised', '=', True)]"/>
                </search>
            </field>
        </record>

         <record id="action_portal_employee_internrequest_all" model="ir.actions.act_window">
            <field name="name">Becarios</field>
            <field name="res_model">portal.hr.employee.intern.request</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'group_by': 'company_id'}</field>
        </record>

         <menuitem id="menu_portal_employee_internrequest_all"
                  name="Becarios"
                  parent="portal_requests.portal_requests_menu"
                  action="action_portal_employee_request_all"
                   groups="portal_requests.group_intern_partner_responsible"
                  sequence="60"/>

    </data>
</odoo>
