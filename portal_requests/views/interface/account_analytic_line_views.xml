<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_analytic_line_filter_inherit_work_group" model="ir.ui.view">
        <field name="name">account.analytic.line.select.inherit.work.group</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date']" position="after">
                <field name="work_group_id"/>
            </xpath>
            <xpath expr="//group[@name='groupby']" position="inside">
                <filter string="Grupo de Trabajo" name="group_by_work_group" context="{'group_by': 'work_group_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_line_pivot_inherit_work_group" model="ir.ui.view">
        <field name="name">account.analytic.line.pivot.inherit.work.group</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_pivot"/>
        <field name="arch" type="xml">
            <!-- Las filas se añaden como nodos propios tras el account_id estándar:
                 Odoo copia los atributos de ese nodo a las columnas de los demás
                 planes analíticos y, si se marcara como fila, cada plan añadiría
                 un nivel de agrupación al pivote. -->
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="work_group_id" type="row"/>
                <field name="account_id" type="row"/>
            </xpath>
        </field>
    </record>

    <!-- El pivote de proyectos hereda en modo primario del anterior y elimina el
         account_id estándar; se retiran aquí las filas añadidas para dejarlo
         exactamente como en Odoo estándar. -->
    <record id="project_view_account_analytic_line_pivot_inherit_work_group" model="ir.ui.view">
        <field name="name">account.analytic.line.pivot.project.inherit.work.group</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="project_account.project_view_account_analytic_line_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_group_id']" position="replace"/>
            <xpath expr="//field[@name='account_id'][@type='row']" position="replace"/>
        </field>
    </record>

    <record id="view_account_analytic_line_tree_inherit_work_group" model="ir.ui.view">
        <field name="name">account.analytic.line.list.inherit.work.group</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="work_group_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
