<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_portal_hr_expensive_request_tree" model="ir.ui.view">
            <field name="name">view.portal.hr.expensive.request.treee</field>
            <field name="model">portal.hr.expensive.request</field>
            <field name="arch" type="xml">
                <list string="Portal Hr Expensive Requests">
                    <field name="user_id"/>
                    <field name="project" string="Proyecto"/>
                    <field name="type"/>
                    <field name="status"/>
                    <field name="is_more"/>
                </list>
            </field>
        </record>

        <record id="view_portal_hr_expensive_request_form" model="ir.ui.view">
            <field name="name">portal.hr.expensive.request.form</field>
            <field name="model">portal.hr.expensive.request</field>
            <field name="arch" type="xml">
                <form string="Portal Invoice Request">
                    <header>
                        <field name="status" widget="statusbar"/>
                        <field name="show_solicitar_revision" invisible="1"/>
                        <!-- Botonera responsable proyecto -->
                        <button name="action_approve"
                                string="Solicitar Revisión"
                                type="object"
                                class="btn-primary"
                                invisible="not show_solicitar_revision"
                                />
                        <!-- Fin botonera responsable proyecto -->
                        <!--Botonera del jefe de equipo -->
                        <button name="action_approve"
                                string="Aprobar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_equip_boss"
                                invisible="status != 'approved_by_boss_group'"
                                />
                        <button name="action_reject"
                                string="Rechazar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_equip_boss"
                                invisible="status != 'approved_by_boss_group'"
                                />
                        <!-- Fin botonera del jefe de equipo -->
                        <!--Botonera del Responsable compras -->
                        <button name="action_approve"
                                string="Aprobar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_purchase_responsible"
                                invisible="status != 'approved_purchase_responsible'"
                                />
                        <button name="action_reject"
                                string="Rechazar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_purchase_responsible"
                                invisible="status != 'approved_purchase_responsible'"
                                />
                        <!-- Fin botonera del Responsable compras -->
                        <!--Botonera del Director gerente -->
                        <button name="action_approve"
                                string="Aprobar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_director_manager"
                                invisible="status != 'approved_director'"
                                />
                        <button name="action_reject"
                                string="Rechazar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_director_manager"
                                invisible="status != 'approved_director'"
                                />
                        <!-- Fin botonera del Director gerente -->
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_created">
                        <field name="invoice_count" widget="statinfo" string="Invoices"/>
                    </button>
                        </div>
                        <group>
                            <group>
                                <field name="type"/>
                                <field name="project" string="Proyecto"/>
                                <field name="user_id"/>
                                <field name="is_more" string="¿Es más de 1000€?"/>
                            </group>
                        </group>
                    </sheet>
                     <chatter/>
                </form>
            </field>
        </record>
