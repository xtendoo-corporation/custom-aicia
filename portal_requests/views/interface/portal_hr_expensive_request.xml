<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_portal_hr_expensive_request_tree" model="ir.ui.view">
            <field name="name">view.portal.hr.expensive.request.treee</field>
            <field name="model">portal.hr.expensive.request</field>
            <field name="arch" type="xml">
                <list string="Portal Hr Expensive Requests">
                    <field name="user_id"/>
                    <field name="project" string="Proyecto"/>
                    <field name="type"/>
                    <field name="status"/>
                    <field name="is_more"/>
                    <field name="create_date" string="Fecha de creación"/>
                    <field name="currency_id" column_invisible="True"/>
                    <field name="liquidation_amount" optional="show"/>
                    <field name="liquidation_invoices_amount" optional="show"/>
                    <field name="liquidation_tickets_amount" optional="show"/>
                    <field name="liquidation_difference" optional="show"
                           decoration-danger="liquidation_difference != 0"/>
                    <field name="liquidation_paid_amount" optional="show"/>
                    <field name="liquidation_pending_amount" optional="show"
                           decoration-danger="liquidation_pending_amount != 0"
                           decoration-success="liquidation_pending_amount == 0 and liquidation_paid_amount != 0"/>
                </list>
            </field>
        </record>

        <record id="view_portal_hr_expensive_request_form" model="ir.ui.view">
            <field name="name">portal.hr.expensive.request.form</field>
            <field name="model">portal.hr.expensive.request</field>
            <field name="arch" type="xml">
                <form string="Portal Invoice Request">
                    <header>
                        <field name="status" widget="statusbar"/>
                        <field name="show_solicitar_revision" invisible="1"/>
                        <!-- Botonera responsable proyecto -->
                        <button name="action_approve"
                                string="Solicitar Revisión"
                                type="object"
                                class="btn-primary"
                                invisible="not show_solicitar_revision"
                                />
                        <!-- Fin botonera responsable proyecto -->
                        <!--Botonera del jefe de equipo -->
                        <button name="action_approve"
                                string="Aprobar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_equip_boss"
                                invisible="status != 'approved_by_boss_group'"
                                />
                        <button name="action_reject"
                                string="Rechazar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_equip_boss"
                                invisible="status != 'approved_by_boss_group'"
                                />
                        <!-- Fin botonera del jefe de equipo -->
                        <!--Botonera del Responsable de personal y compras -->
                        <button name="action_approve"
                                string="Aprobar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_personnel_purchase_responsible,portal_requests.group_intern_partner_responsible"
                                invisible="status != 'approved_purchase_responsible'"
                                />
                        <button name="action_reject"
                                string="Rechazar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_personnel_purchase_responsible,portal_requests.group_intern_partner_responsible"
                                invisible="status != 'approved_purchase_responsible'"
                                />
                        <!-- Fin botonera del Responsable de personal y compras -->
                        <!--Botonera del Director gerente -->
                        <button name="action_approve"
                                string="Aprobar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_director_manager"
                                invisible="status != 'approved_director'"
                                />
                        <button name="action_reject"
                                string="Rechazar"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_director_manager"
                                invisible="status != 'approved_director'"
                                />
                        <!-- Fin botonera del Director gerente -->
                        <!-- Marcar gratificación como pagada (Responsable de Clientes y Becarios) -->
                        <field name="show_mark_paid_button" invisible="1"/>
                        <button name="action_mark_paid"
                                string="Marcar como pagada"
                                type="object"
                                class="btn-primary"
                                groups="portal_requests.group_intern_partner_responsible"
                                invisible="not show_mark_paid_button"
                                />
                        <!-- Reembolso de la liquidación de gastos (Contabilidad) -->
                        <field name="is_reimbursed" invisible="1"/>
                        <button name="action_register_employee_payment"
                                string="Reembolsar al empleado"
                                type="object"
                                class="btn-primary"
                                groups="account.group_account_invoice"
                                invisible="type != 'liquidacion_gastos' or status != 'approve' or is_reimbursed"
                                />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_created">
                        <field name="invoice_count" widget="statinfo" string="Invoices"/>
                    </button>
                            <button name="action_view_expense" type="object" class="oe_stat_button"
                                    icon="fa-money" string="Gasto" invisible="not expense_id"/>
                            <field name="expense_id" invisible="1"/>
                            <button name="action_view_employee_invoices" type="object" class="oe_stat_button"
                                    icon="fa-file-text-o" invisible="not employee_invoice_count">
                                <field name="employee_invoice_count" widget="statinfo" string="Facturas AICIA"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Reembolsada" bg_color="text-bg-success"
                                invisible="not is_reimbursed"/>
                        <group>
                            <group>
                                <field name="type"/>
                                <field name="project" string="Proyecto"/>
                                <field name="user_id"/>
                                <field name="is_more" string="¿Es más de 10.000€?"/>
                                <field name="inmovilizado_account_id" widget="many2one"
                                    invisible="type != 'material_inventariable'"
                                    required="type == 'material_inventariable'"
                                    groups="portal_requests.group_personnel_purchase_responsible,portal_requests.group_director_manager"/>
                                <field name="bank_account"
                                    invisible="type != 'material_inventariable'"
                                    groups="portal_requests.group_personnel_purchase_responsible,portal_requests.group_director_manager"
                                placeholder="Rellenar solo en caso necesario" />
                                <field name="show_project_credit" invisible="1"/>
                                <field name="project_credit"
                                    invisible="not show_project_credit"/>
                                <field name="show_group_credit" invisible="1"/>
                                <field name="group_credit"
                                    invisible="not show_group_credit"/>
                            </group>
                            <group string="Liquidación de gastos" invisible="type != 'liquidacion_gastos'">
                                <field name="currency_id" invisible="1"/>
                                <field name="liquidation_amount"/>
                                <field name="liquidation_invoices_amount"/>
                                <field name="liquidation_tickets_amount"/>
                                <field name="liquidation_difference"
                                       decoration-danger="liquidation_difference != 0"/>
                                <field name="liquidation_paid_amount"/>
                                <field name="liquidation_pending_amount"
                                       decoration-danger="liquidation_pending_amount != 0"
                                       decoration-success="liquidation_pending_amount == 0 and liquidation_paid_amount != 0"/>
                            </group>
                            <group string="Pago de gratificación" invisible="type != 'gratificacion'">
                                <field name="is_paid"/>
                                <field name="paid_date" invisible="not is_paid"/>
                                <field name="paid_by_id" invisible="not is_paid"/>
                            </group>
                        </group>
                        <group string="Documentos" invisible="type != 'liquidacion_gastos'">
                            <group>
                                <field name="ticket_attachment_ids" widget="many2many_binary" readonly="1"
                                       invisible="not ticket_attachment_ids"/>
                            </group>
                            <group>
                                <field name="employee_invoice_attachment_ids" widget="many2many_binary" readonly="1"
                                       invisible="not employee_invoice_attachment_ids"/>
                                <field name="payment_order_attachment_ids" widget="many2many_binary" readonly="1"
                                       invisible="not payment_order_attachment_ids"/>
                            </group>
                        </group>
                    </sheet>
                     <chatter/>
                </form>
            </field>
        </record>
