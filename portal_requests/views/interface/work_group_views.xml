<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_work_group_tree" model="ir.ui.view">
            <field name="name">portal.work.group.tree</field>
            <field name="model">portal.work.group</field>
            <field name="arch" type="xml">
                <tree string="Grupos de Trabajo">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="user_ids" widget="many2many_tags"/>
                    <field name="equip_boss"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_work_group_form" model="ir.ui.view">
            <field name="name">portal.work.group.form</field>
            <field name="model">portal.work.group</field>
            <field name="arch" type="xml">
                <form string="Grupo de Trabajo">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Usuarios">
                                <field name="user_ids"/>
                                <field name="equip_boss_domain" invisible="1"/>
                                <label for="equip_boss">Jefe de equipo</label>
                                <field name="equip_boss" string="Jefe de equipo"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="action_work_group" model="ir.actions.act_window">
            <field name="name">Grupos de Trabajo</field>
            <field name="res_model">portal.work.group</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_portal_work_group"
                  name="Grupos de Trabajo"
                  parent="portal_requests.portal_requests_menu"
                  action="action_work_group"
                  sequence="60"/>
    </data>
</odoo>
