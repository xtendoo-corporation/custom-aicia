<odoo>

    <record id="view_document_approval_tree" model="ir.ui.view">
        <field name="name">document.approval.tree</field>
        <field name="model">document.approval</field>
        <field name="arch" type="xml">
            <tree>
                <field name="type_id"/>
                <field name="description"/>
                <field name="approved"/>
                <field name="group_approval_id" readonly="1"/>
                <field name="is_revised"/>

            </tree>
        </field>
    </record>

    <record id="view_document_approval_form" model="ir.ui.view">
        <field name="name">document.approval.form</field>
        <field name="model">document.approval</field>
        <field name="arch" type="xml">
            <form>
                <header>
                         <button name="action_approve"
                                string="Approve"
                                type="object"
                                class="btn-primary"
                                invisible="is_revised == True"/>
                        <button name="action_reject"
                                string="Reject"
                                type="object"
                                class="btn-secondary"
                                invisible="is_revised == True"/>
                        <button name="action_to_revise"
                                string="Para Revisar"
                                type="object"
                                class="btn-secondary"
                                invisible="not is_revised or approved"/>

                    </header>
                <sheet>
                    <group>
                        <field name="type_id"/>
                        <field name="description"/>
                        <field name="approved" invisible="1"/>
                        <field name="group_approval_id" readonly="1"/>
                        <field name="is_revised" invisible="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_document_approval_search" model="ir.ui.view">
            <field name="name">document.approval.search</field>
            <field name="model">document.approval</field>
            <field name="arch" type="xml">
                <search string="Facturas">
                    <field name="is_revised"/>
                    <filter string="Para revisar" name="approved_filter" domain="[('is_revised', '=', False)]"/>
                    <field name="approved"/>
                    <filter string="Aprobadas" name="approved_filter" domain="[('approved', '=', True)]"/>
                    <field name="approved"/>
                    <filter string="Rechazadas" name="rejected_filter" domain="[('approved', '=', False), ('is_revised', '=', True)]"/>
                </search>
            </field>
        </record>

    <record id="action_document_approval_all" model="ir.actions.act_window">
        <field name="name">Documentos</field>
        <field name="res_model">document.approval</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>




