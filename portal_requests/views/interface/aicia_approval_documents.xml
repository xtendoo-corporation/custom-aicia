<odoo>

    <record id="view_document_approval_tree" model="ir.ui.view">
        <field name="name">document.approval.tree</field>
        <field name="model">document.approval</field>
        <field name="arch" type="xml">
            <tree>
                <field name="type_id"/>
                <field name="description"/>
                <field name="status" />
                <field name="company_id" invisible="0"/>
                <field name="user_id" invisible="0"/>


            </tree>
        </field>
    </record>

    <record id="view_document_approval_form" model="ir.ui.view">
        <field name="name">document.approval.form</field>
        <field name="model">document.approval</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"/>
                    <!-- Botonera del I+D -->
                         <button name="action_approve"
                                string="Aprobar"
                                type="object"
                                class="btn-primary"
                                 groups="portal_requests.group_director_investigation_and_development"
                                 invisible="status not in ('approved_by_director_i_d')"
                                />
                        <button name="action_reject"
                                string="Rechazar"
                                type="object"
                                class="btn-secondary"
                                groups="portal_requests.group_director_investigation_and_development"
                                invisible="status not in ('approved_by_director_i_d')"
                                />
                    <!-- Fin Botonera del I+D -->
                    <!-- Botonera director financiero -->
                    <button name="action_approve"
                                string="Aprobar"
                                type="object"
                                class="btn-primary"
                                 groups="portal_requests.group_financial_director"
                                 invisible="status not in ('sign_director_accounting')"
                                />
                        <button name="action_reject"
                                string="Rechazar"
                                type="object"
                                class="btn-secondary"
                                groups="portal_requests.group_financial_director"
                                invisible="status not in ('sign_director_accounting')"
                                />
                    <!-- Fin Botonera director financiero -->
                     <!-- Botonera del Director Gerente -->
<!--                                <button name="request_partner_sign"-->
<!--                                    string="Solicitar firma empresa"-->
<!--                                    type="object"-->
<!--                                    class="btn-primary"-->
<!--                                     groups="portal_requests.group_director_manager"-->
<!--                                        invisible="status not in ('sign_company')"-->
<!--                                    />-->
                                 <button name="action_approve"
                                        string="Aprobar"
                                        type="object"
                                        class="btn-primary"
                                         groups="portal_requests.group_director_manager"
                                         invisible="status not in ('sign_company')"
                                        />
                                <button name="action_reject"
                                        string="Rechazar"
                                        type="object"
                                        class="btn-secondary"
                                        groups="portal_requests.group_director_manager"
                                        invisible="status not in ('sign_company')"
                                        />
                                <button name="action_to_revise"
                                        string="Para Revisar"
                                        type="object"
                                        class="btn-secondary"
                                        groups="portal_requests.group_director_manager"
                                        invisible="status not in ('rejected','approve')"
                                        />
                    <!-- Fin Botonera del Director Gerente -->

                    </header>
                <sheet>
                    <group>
                        <field name="type_id"/>
                        <field name="description"/>
                        <field name="company_id" invisible="0"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_document_approval_search" model="ir.ui.view">
            <field name="name">document.approval.search</field>
            <field name="model">document.approval</field>
            <field name="arch" type="xml">
                <search string="Facturas">
                    <field name="status"/>
                    <filter string="Aprobación Director I+D" name="approved_filter" domain="[('status', '=', 'approved_by_director_i_d')]"/>
                    <filter string="Firma de director Financiero" name="approved_filter" domain="[('status', '=', 'sign_director_accounting')]"/>
                    <filter string="Esperando firma de la empresa" name="approved_filter" domain="[('status', '=', 'sign_company')]"/>
                    <filter string="Aprobadas" name="approved_filter" domain="[('status', '=', 'approve')]"/>
                    <filter string="Rechazadas" name="rejected_filter" domain="[('status', '=', 'rejected')]"/>
                </search>
            </field>
        </record>

    <record id="action_document_approval_all" model="ir.actions.act_window">
        <field name="name">Documentos</field>
        <field name="res_model">document.approval</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>




