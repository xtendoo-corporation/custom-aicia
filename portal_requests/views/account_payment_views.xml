<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_analytic_distribution" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.analytic.distribution</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <group string="Analítica">
                    <field name="main_invoice_analytic_distribution" widget="json"/>
                </group>
            </sheet>
        </field>
    </record>

    <record id="view_account_payment_tree_inherit_analytic_distribution" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.analytic.distribution</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="main_invoice_analytic_distribution" widget="json"/>
            </list>
        </field>
    </record>
</odoo>

