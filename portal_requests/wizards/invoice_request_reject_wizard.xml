<odoo>
  <record id="view_pinvoice_request_reject_wizard_form" model="ir.ui.view">
    <field name="name">view.pinvoice.request.reject.wizard.form</field>
    <field name="model">invoice.request.reject.wizard</field>
    <field name="arch" type="xml">
      <form string="Rechazar solicitud">
        <sheet>
          <group>
            <field name="descripcion"/>
          </group>
        </sheet>
        <footer>
          <button string="Aceptar" type="object" name="action_accept" class="btn-primary"/>
          <button string="Cancelar" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>
