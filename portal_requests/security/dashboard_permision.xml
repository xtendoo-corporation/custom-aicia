<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="portal_request_dashboard_record_rule" model="ir.rule">
            <field name="name">Restrict Visibility by Groups</field>
            <field name="model_id" ref="model_portal_request_dashboard"/>
            <field name="global" eval="False"/>
            <field name="domain_force">
                [('allowed_group_ids', 'in', user.group_ids.ids)]
            </field>
        </record>
    </data>
</odoo>
