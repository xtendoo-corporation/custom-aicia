<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="base.es" model="res.country">
        <field name="address_format" eval="'%(company_name)s\n%(street)s\n%(street2)s\n%(city)s %(state_code)s %(zip)s\n%(country_name)s'"/>
    </record>

    <template id="external_layout_aicia" inherit_id="web.external_layout_wave" name="Layout AICIA con logo grande">
        <xpath expr="//t[@t-set='header_shape_height']" position="attributes">
            <attribute name="t-value">'267'</attribute>
        </xpath>

        <xpath expr="//div[contains(@class, 'd-flex justify-content-between')]/div[1]" position="attributes">
            <attribute name="class" remove="w-50" separator=" "/>
            <attribute name="style">width: 30% !important;</attribute>
        </xpath>

        <xpath expr="//div[@name='company_address']" position="attributes">
            <attribute name="class" remove="w-50" separator=" "/>
            <attribute name="style">width: 70% !important;</attribute>
        </xpath>

        <xpath expr="//img[@t-if='company.logo']" position="before">
            <style>
                .o_company_logo {
                    max-height: 8rem !important;
                    max-width: 10rem !important;
                }

                div[name='company_address'] ul[name='company_address_list'] li span[t-field='company.company_details'] > div:first-child,
                div[name='company_address'] ul[name='company_address_list'] li span[t-field='company.company_details'] > div:nth-child(2) {
                    display: inline !important;
                    white-space: nowrap !important;
                }

                div[name='company_address'] ul[name='company_address_list'] li span[t-field='company.company_details'] > div:first-child::after {
                    content: " ";
                }

                div[name='company_address'] ul[name='company_address_list'] li span[t-field='company.company_details'] > div:first-child br:first-child {
                    display: none !important;
                }
            </style>
        </xpath>
    </template>

    <template id="report_invoice_document_aicia" inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_quantity']" position="replace"/>

        <xpath expr="//td[@name='td_quantity']" position="replace"/>

        <xpath expr="//th[@name='th_priceunit']" position="replace"/>

        <xpath expr="//td[@name='td_price_unit']" position="replace"/>

        <xpath expr="//t[@name='invoice_title']" position="replace">
            <t name="invoice_title">Número de Factura</t>
        </xpath>

        <xpath expr="//tr[.//i[contains(@class, 'oe_payment_label')]]" position="replace">
        </xpath>

        <xpath expr="//tr[.//span[@t-field='o.amount_residual']]" position="replace">
        </xpath>

        <xpath expr="//t[@t-set='display_taxes']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <xpath expr="//div[@name='due_date']" position="replace">
        </xpath>

        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="t-if">o.invoice_date or o.delivery_date or o.invoice_origin or o.partner_id.ref or o.ref or o.invoice_incoterm_id</attribute>
        </xpath>

        <xpath expr="//div[@name='reference']/strong" position="replace">
            <strong>Número de Pedido</strong>
        </xpath>

        <xpath expr="//div[@name='reference']" position="attributes">
            <attribute name="t-if">1</attribute>
        </xpath>

        <xpath expr="//div[@name='customer_code']" position="replace">
        </xpath>

        <xpath expr="//div[@name='comment']" position="after">
            <div class="mt-3 mb-3" style="font-size: 0.9rem;">
                <p class="mb-1"><strong>Transferencia C/C:</strong></p>
                <p class="mb-1">IBAN ES55 0049 2588 7420 1426 3713</p>
                <p class="mb-1">AV. CONSTITUCIÓN, 3 APDO. 34</p>
                <p class="mb-0">41004 SEVILLA</p>
            </div>
        </xpath>
    </template>

    <template id="document_tax_totals_custom" inherit_id="account.document_tax_totals">
        <xpath expr="//tr[@class='o_subtotal']" position="attributes">
            <attribute name="style">font-weight: bold;</attribute>
        </xpath>
        <xpath expr="//tr[@class='o_taxes']" position="attributes">
            <attribute name="style">font-weight: bold;</attribute>
        </xpath>
    </template>

</odoo>
