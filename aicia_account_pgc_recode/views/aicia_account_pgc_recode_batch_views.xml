<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aicia_account_pgc_recode_batch_tree" model="ir.ui.view">
        <field name="name">aicia.account.pgc.recode.batch.tree</field>
        <field name="model">aicia.account.pgc.recode.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="move_line_count"/>
                <field name="applied_line_count"/>
                <field name="review_line_count"/>
                <field name="manual_line_count"/>
                <field name="state" widget="badge" decoration-info="state == 'simulated'" decoration-success="state == 'applied'" decoration-warning="state == 'partially_applied'" decoration-muted="state == 'reverted'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_aicia_account_pgc_recode_batch_form" model="ir.ui.view">
        <field name="name">aicia.account.pgc.recode.batch.form</field>
        <field name="model">aicia.account.pgc.recode.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply_automatic" string="Aplicar borrador" type="object" class="btn-primary" invisible="state not in ('simulated', 'partially_applied')"/>
                    <button name="action_apply_selected" string="Aplicar con revisión manual" type="object" class="btn-secondary" invisible="state not in ('simulated', 'partially_applied')"/>
                    <button name="action_revert" string="Revertir" type="object" invisible="state not in ('applied', 'partially_applied')" confirm="¿Seguro que deseas revertir todas las líneas aplicadas de este lote?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,simulated,applied,reverted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="move_line_count"/>
                            <field name="applied_line_count"/>
                            <field name="review_line_count"/>
                            <field name="manual_line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de recodificación" name="lines">
                            <field name="line_ids">
                                <list editable="bottom" create="false" delete="false" decoration-success="applied == True" decoration-warning="status == 'review'" decoration-danger="status == 'error'" decoration-muted="status == 'discarded' or status == 'manual'">
                                    <field name="date" readonly="1"/>
                                    <field name="move_id" readonly="1"/>
                                    <field name="old_account_code" readonly="1"/>
                                    <field name="old_account_name" readonly="1"/>
                                    <field name="name" readonly="1"/>
                                    <field name="company_currency_id" column_invisible="True"/>
                                    <field name="debit" readonly="1" sum="Total debe"/>
                                    <field name="credit" readonly="1" sum="Total haber"/>
                                    <field name="new_account_code" readonly="status not in ('review', 'manual') or applied == True"/>
                                    <field name="new_account_id" readonly="status not in ('review', 'manual') or applied == True" optional="show"/>
                                    <field name="status" readonly="1" widget="badge"/>
                                    <field name="blocking_reason" readonly="1" optional="show"/>
                                    <field name="confidence" readonly="1" optional="hide"/>
                                    <field name="applied" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aicia_account_pgc_recode_batch" model="ir.actions.act_window">
        <field name="name">Lotes de recodificación</field>
        <field name="res_model">aicia.account.pgc.recode.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
