<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aicia_account_pgc_recode_import_wizard_form" model="ir.ui.view">
        <field name="name">aicia.account.pgc.recode.import.wizard.form</field>
        <field name="model">aicia.account.pgc.recode.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar reglas">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="clear_existing_rules"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_aicia_account_pgc_recode_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar equivalencias</field>
        <field name="res_model">aicia.account.pgc.recode.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
