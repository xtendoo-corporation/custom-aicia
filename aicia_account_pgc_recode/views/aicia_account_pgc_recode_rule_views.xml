<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_aicia_account_pgc_recode_rule_tree" model="ir.ui.view">
        <field name="name">aicia.account.pgc.recode.rule.tree</field>
        <field name="model">aicia.account.pgc.recode.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false" decoration-danger="collision == True" decoration-success="status == 'automatic'" decoration-warning="status == 'review'" decoration-muted="status == 'discarded'">
                <field name="old_code" readonly="1"/>
                <field name="old_name" readonly="1" optional="show"/>
                <field name="target_prefix"/>
                <field name="target_label" optional="hide"/>
                <field name="proposed_account_id" domain="[('company_ids', '=', company_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="proposed_code" readonly="1" optional="hide"/>
                <field name="status" widget="badge"/>
                <field name="confidence" optional="hide"/>
                <field name="collision" readonly="1" optional="show"/>
                <field name="notes" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_aicia_account_pgc_recode_rule_form" model="ir.ui.view">
        <field name="name">aicia.account.pgc.recode.rule.form</field>
        <field name="model">aicia.account.pgc.recode.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_automatic" string="Marcar como automática" type="object" invisible="status == 'automatic'"/>
                    <button name="action_mark_review" string="Marcar para revisión" type="object" invisible="status == 'review'"/>
                    <button name="action_mark_manual" string="Marcar como manual" type="object" invisible="status == 'manual'"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,automatic,review,manual,discarded,applied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="old_code" placeholder="Código de cuenta anterior"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="old_name"/>
                            <field name="target_prefix"/>
                            <field name="target_label"/>
                        </group>
                        <group>
                            <field name="proposed_account_id" domain="[('company_ids', '=', company_id)]" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="proposed_code" readonly="1"/>
                            <field name="confidence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group invisible="not proposed_code or proposed_account_id">
                        <div class="alert alert-danger" role="alert">
                            <strong>La subcuenta propuesta no existe.</strong>
                            Debe existir previamente en el plan contable de la compañía para que la regla pueda aplicarse de forma automática.
                        </div>
                    </group>
                    <group invisible="not collision">
                        <div class="alert alert-warning" role="alert">
                            <strong>Colisión detectada.</strong> <field name="collision_notes"/>
                        </div>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes" placeholder="Notas internas..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_aicia_account_pgc_recode_rule_search" model="ir.ui.view">
        <field name="name">aicia.account.pgc.recode.rule.search</field>
        <field name="model">aicia.account.pgc.recode.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="old_code"/>
                <field name="target_prefix"/>
                <field name="proposed_code"/>
                <filter string="Automáticas" name="status_automatic" domain="[('status', '=', 'automatic')]"/>
                <filter string="En revisión" name="status_review" domain="[('status', '=', 'review')]"/>
                <filter string="Manual" name="status_manual" domain="[('status', '=', 'manual')]"/>
                <filter string="Con colisiones" name="with_collision" domain="[('collision', '=', True)]"/>
                <filter string="Aplicadas" name="status_applied" domain="[('status', '=', 'applied')]"/>
                <group>
                    <filter string="Estado" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Prefijo destino" name="group_by_target" context="{'group_by': 'target_prefix'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_aicia_account_pgc_recode_rule" model="ir.actions.act_window">
        <field name="name">Reglas de recodificación</field>
        <field name="res_model">aicia.account.pgc.recode.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
