<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista de las líneas de reparto analítico -->
    <record id="view_employee_analytic_line_tree" model="ir.ui.view">
        <field name="name">aicia.employee.analytic.line.tree</field>
        <field name="model">aicia.employee.analytic.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="employee_id"/>
                <field name="analytic_account_id" string="Proyecto" required="1"/>
                <field name="percentage" string="Porcentaje (%)"/>
                <field name="date_start" string="Fecha de inicio"/>
            </list>
        </field>
    </record>

    <!-- Herencia del formulario de empleado: smart button de Reparto analítico -->
    <record id="view_employee_form_analytic_percentage_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.analytic.percentage.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_analytic_lines"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pie-chart">
                    <field name="analytic_line_count" widget="statinfo" string="Reparto"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>

