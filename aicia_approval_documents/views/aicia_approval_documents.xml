    <record id="view_document_approval_tree" model="ir.ui.view">
        <field name="name">document.approval.tree</field>
        <field name="model">document.approval</field>
        <field name="arch" type="xml">
            <tree>
                <field name="type_id"/>
                <field name="description"/>
                <field name="approved"/>
                <field name="group_approval_id"/>
            </tree>
        </field>
    </record>

    <record id="view_document_approval_form" model="ir.ui.view">
        <field name="name">document.approval.form</field>
        <field name="model">document.approval</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type_id"/>
                        <field name="description"/>
                        <field name="approved" widget="toggle_button"/>
                        <field name="group_approval_id"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

